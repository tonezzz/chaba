FROM docker.io/library/python:3.14-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --index-url https://pypi.org/simple \
    --extra-index-url https://download.pytorch.org/whl/cu126 \
    "torch==2.14.0+cu126" \
    "torchvision==0.29.0+cu126" \
    ultralytics \
    ultralytics-thop

COPY server.py yolov8n.pt ./

ENV GO2RTC_BASE=http://127.0.0.1:1984 \
    GO2RTC_SOURCE=xiaomi_c201 \
    YOLO_HOST=0.0.0.0 \
    YOLO_PORT=8780

EXPOSE 8780

CMD ["python", "-u", "server.py"]
