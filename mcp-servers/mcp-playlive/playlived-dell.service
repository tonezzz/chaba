[Unit]
Description=Playlive headless browser daemon on tony-dell
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/tony/.local/playlive
ExecStartPre=/home/tony/CascadeProjects/chaba-tony-dell/mcp-servers/mcp-playlive/patch-playwright.sh
ExecStart=/home/tony/.local/node/bin/node /home/tony/.local/playlive/playlived.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
