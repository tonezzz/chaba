diff --git a/services/mddbd/replication_server.go b/services/mddbd/replication_server.go
index f3cbfb2f..35d2e7ed 100644
--- a/services/mddbd/replication_server.go
+++ b/services/mddbd/replication_server.go
@@ -90,6 +90,33 @@ type FollowerState struct {
 	LastSentAt atomic.Int64
 }
 
+// followerLagMs reports a follower's real commit-to-apply lag in
+// milliseconds — the wall-clock age of the entry at its acknowledged
+// position, the same quantity the follower self-reports. It is 0 once the
+// confirmed LSN covers the leader's head, so an idle-but-caught-up follower
+// does not report the leader's write-idleness as lag. It replaces the old
+// LSN-diff×10 estimate, which conflated entry count with time and could not
+// agree with the follower's own commit-ts measurement of the same position.
+//
+// The commit timestamp comes from the binlog's bounded recent index. When
+// the confirmed position predates it, the age of the index floor is
+// returned — a lower bound on the real lag, so a very stale follower still
+// reads as very stale rather than 0.
+func followerLagMs(fs *FollowerState, currentLSN uint64, b *binlog.Binlog, now time.Time) int64 {
+	if fs.ConfirmedLSN >= currentLSN {
+		return 0
+	}
+	if ts, ok := b.TimestampAt(fs.ConfirmedLSN); ok {
+		return max(now.Sub(time.Unix(0, ts)).Milliseconds(), 0)
+	}
+	if ts, ok := b.TimestampAt(b.RecentFloorLSN()); ok {
+		return max(now.Sub(time.Unix(0, ts)).Milliseconds(), 0)
+	}
+	// Nothing indexed at all — fall back to the legacy gap-proportional
+	// estimate rather than reporting 0 for a behind follower.
+	return int64(currentLSN-fs.ConfirmedLSN) * 10 // #nosec G115 -- LSN diff within int64 range
+}
+
