+	// Lag is now real commit-to-apply time, not (lsn gap)*10: the entries
+	// were committed milliseconds ago, so a behind follower still reports
+	// ~0 lag. The scaled-LSN estimate would have reported (10-3)*10=70.
+	if follower.LagMs < 0 {
+		t.Errorf("expected non-negative lag when follower is behind (currentLSN=%d, confirmed=3), got %d", currentLSN, follower.LagMs)
+	}
+	if follower.LagMs >= 30000 {
+		t.Errorf("fresh entries should give near-zero real lag, got %d", follower.LagMs)
+	}
+
+	// Same follower, same LSNs, queried 10 minutes later: real lag tracks
+	// the commit-ts age (~10min), not the LSN gap.
+	later := followerLagMs(rs.followers["lag-follower"], currentLSN, s.Binlog, time.Now().Add(10*time.Minute))
+	if later < 9*time.Minute.Milliseconds() {
+		t.Errorf("expected ~10min real lag when queried 10min after commit, got %d", later)
 	}
 }
 
