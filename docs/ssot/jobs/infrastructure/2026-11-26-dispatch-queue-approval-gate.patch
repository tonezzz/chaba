+def caller_user() -> str:
+    """OS user behind this CLI invocation (SUDO_USER wins under sudo)."""
+    sudo_user = os.environ.get("SUDO_USER")
+    if sudo_user:
+        return sudo_user
+    try:
+        return getpass.getuser()
+    except Exception:
+        return os.environ.get("USER") or "unknown"
+
+
+def _yaml_scalar(s: str) -> Any:
+    s = s.strip()
+    if s.startswith("[") and s.endswith("]"):
+        inner = s[1:-1].strip()
+        return [_yaml_scalar(x) for x in inner.split(",")] if inner else []
+    if len(s) >= 2 and s[0] == s[-1] and s[0] in ("'", '"'):
+        return s[1:-1]
+    if s in ("true", "True"):
+        return True
+    if s in ("false", "False"):
+        return False
+    if s in ("null", "~", ""):
+        return None
+    try:
+        return int(s)
+    except ValueError:
+        pass
+    try:
+        return float(s)
+    except ValueError:
+        pass
+    return s
+
+
+def _parse_simple_yaml(text: str) -> Dict[str, Any]:
+    """Minimal YAML-subset loader for approval_policy.yml.
+
+    Supports nested maps, block lists (`- item`), inline `[a, b]` lists and
+    scalar values — everything the policy file needs — so queue_manager does
+    not depend on PyYAML being importable by the system python3.
+    """
+    raw = []
+    for line in text.splitlines():
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            continue
+        # strip trailing " # comment" (policy file uses no '#' inside values)
+        stripped = stripped.split(" #", 1)[0].rstrip()
+        if not stripped:
+            continue
+        raw.append((len(line) - len(line.lstrip(" ")), stripped))
+    if not raw:
+        return {}
+    pos = 0
+
+    def parse(indent: int):
+        nonlocal pos
+        if pos >= len(raw):
+            return None
+        if raw[pos][1].startswith("- "):
+            lst = []
+            while pos < len(raw) and raw[pos][0] == indent and raw[pos][1].startswith("- "):
+                lst.append(_yaml_scalar(raw[pos][1][2:]))
+                pos += 1
+            return lst
+        out = {}
+        while pos < len(raw):
+            ind, content = raw[pos]
+            if ind < indent or content.startswith("- "):
+                break
+            if ind > indent:
+                pos += 1
+                continue
+            key, _, val = content.partition(":")
+            key = key.strip().strip("'\"")
+            pos += 1
+            val = val.strip()
+            if val == "":
+                if pos < len(raw) and raw[pos][0] > indent:
+                    out[key] = parse(raw[pos][0])
+                else:
+                    out[key] = None
+            else:
+                out[key] = _yaml_scalar(val)
+        return out
+
+    return parse(raw[0][0]) or {}
+
+
+def load_approval_policy(path: Optional[str] = None) -> Dict[str, Any]:
+    """Load approval_policy.yml (repo root by default), merged over defaults."""
+    policy_path = Path(path) if path else Path(__file__).resolve().parent.parent / "approval_policy.yml"
+    data: Dict[str, Any] = {}
+    if policy_path.is_file():
+        try:
+            text = policy_path.read_text()
+            try:
+                import yaml  # type: ignore
+                data = yaml.safe_load(text) or {}
+            except ImportError:
+                data = _parse_simple_yaml(text)
+        except Exception as e:
+            print(f"queue_manager: warning: could not parse {policy_path}: {e}; "
+                  f"using built-in defaults", file=sys.stderr)
+            data = {}
+    pol = data.get("approval", data) if isinstance(data, dict) else {}
+    merged = dict(DEFAULT_APPROVAL_POLICY)
+    if isinstance(pol, dict):
+        merged.update({k: v for k, v in pol.items() if k != "require_approval_when"})
+        rules = dict(DEFAULT_APPROVAL_POLICY["require_approval_when"])
+        extra = pol.get("require_approval_when")
+        if isinstance(extra, dict):
+            rules.update(extra)
+        merged["require_approval_when"] = rules
+    return merged
