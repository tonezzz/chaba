+# Dispatch queue approval policy — RBAC-lite gate
+#
+# Card: dispatch-queue-approval-gate (follow-up to awx-aap-rbac-approval-gates,
+# decision: do-not-adopt-AWX — docs/ssot/jobs/infrastructure/
+# 2026-11-25-awx-aap-rbac-approval-gates-decision.yml in the chaba repo).
+#
+# Jobs matching require_approval_when are held in queue:pending:{priority}
+# with status=awaiting_approval — the scheduler never sees them until
+# `queue_manager.py approve <job_id> --by <approver>` LPUSHes them onto
+# queue:jobs:{priority}. Pending jobs expire to approval_state=expired
+# after ttl_sec (swept by the scheduler tick).
+#
+# NOTE: queue_manager.py reads this file without requiring PyYAML — keep to
+# the supported subset: nested maps, `- item` lists, `[a, b]` inline lists,
+# scalars, `#` comments.
+
+approval:
+  enabled: true
+  ttl_sec: 86400            # pending approvals expire after 24h
+  self_approve: true        # single-operator fleet: tony may approve own jobs
+  approvers:                # users allowed to run approve/reject
+    - tony
+  require_approval_when:
+    job_gpus_gt: 0          # any job requesting GPUs (job_gpus > 0)
+    priority_lte: 2         # priority 0-2 (CRITICAL=0, HIGH=1, and above-normal)
+    tags_any: [gpu]         # 'gpu' appearing in job_require_tags
