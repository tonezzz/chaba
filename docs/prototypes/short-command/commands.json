{
  "version": 1,
  "comment": "Shared short-command grammar (T0 templates + T1 exemplars). Syntax: (a|b) alternation, [x] optional, {slot} placeholder. Slot kinds: 'list' (canonical -> aliases), 'regex' (pattern list), 'rest' (capture remainder). Whitespace in templates matches zero-or-more so unspaced Thai works.",
  "slot_lists": {
    "name": {
      "kind": "list",
      "values": {
        "kitchen light": [
          "kitchen light",
          "kitchen lights",
          "ไฟครัว",
          "ไฟในครัว"
        ],
        "living room light": [
          "living room light",
          "living room lights",
          "ไฟห้องนั่งเล่น",
          "ไฟห้องรับแขก"
        ],
        "bedroom fan": [
          "bedroom fan",
          "fan",
          "พัดลมห้องนอน",
          "พัดลม"
        ],
        "air conditioner": [
          "air conditioner",
          "aircon",
          "air",
          "แอร์"
        ],
        "tv": [
          "tv",
          "television",
          "ทีวี"
        ]
      }
    },
    "area": {
      "kind": "list",
      "values": {
        "kitchen": [
          "kitchen",
          "ครัว",
          "ในครัว",
          "ห้องครัว"
        ],
        "living room": [
          "living room",
          "ห้องนั่งเล่น",
          "ห้องรับแขก"
        ],
        "bedroom": [
          "bedroom",
          "ห้องนอน"
        ],
        "office": [
          "office",
          "ห้องทำงาน",
          "ออฟฟิศ",
          "ออฟฟิส"
        ]
      }
    },
    "ref": {
      "kind": "regex",
      "patterns": [
        "ops[- ]?\\d{3,4}",
        "[a-z][a-z0-9-]+-[0-9a-f]{6}",
        "\\d{3,4}"
      ]
    },
    "num": {
      "kind": "regex",
      "patterns": [
        "\\d{1,3}"
      ]
    },
    "note": {
      "kind": "rest",
      "patterns": [
        ".+"
      ]
    }
  },
  "intents": [
    {
      "intent": "HassTurnOn",
      "templates": [
        "(turn|switch) on [the] {name}",
        "turn [the] {name} on",
        "เปิด {name}",
        "เปิดไฟ {area}"
      ],
      "exemplars": [
        "turn on the heater",
        "switch the lamp on",
        "power on the monitor",
        "เปิดเครื่องทำน้ำอุ่น",
        "turn the fan on please"
      ]
    },
    {
      "intent": "HassTurnOff",
      "templates": [
        "(turn|switch) off [the] {name}",
        "turn [the] {name} off",
        "ปิด {name}",
        "ปิดไฟ {area}"
      ],
      "exemplars": [
        "turn off the heater",
        "shut off the lamp",
        "ปิดเครื่องทำน้ำอุ่น",
        "power down the monitor"
      ]
    },
    {
      "intent": "HassLightSet",
      "templates": [
        "(set|dim) [the] {name} [brightness] to {num} percent",
        "ปรับ {name} (เป็น|เหลือ) {num} เปอร์เซ็นต์"
      ],
      "exemplars": [
        "set the lamp to 50 percent",
        "dim the lights to twenty"
      ]
    },
    {
      "intent": "GetTime",
      "templates": [
        "what time is it [(now|right now|today)]",
        "what time is it",
        "what's the time",
        "กี่โมง [(แล้ว|ละ|เอง)]",
        "ตอนนี้กี่โมง",
        "บอกเวลา [(หน่อย|ให้หน่อย|ด้วย)]"
      ],
      "exemplars": [
        "tell me the time",
        "time please",
        "เวลาเท่าไหร่"
      ]
    },
    {
      "intent": "GetDate",
      "templates": [
        "what('s| is) [the] (date|day) [(today|is it)]",
        "วันนี้วันที่เท่าไหร่",
        "วันนี้วันอะไร"
      ],
      "exemplars": [
        "what day is today",
        "date please",
        "วันที่เท่าไหร่"
      ]
    },
    {
      "intent": "BoardExplain",
      "templates": [
        "(explain|status) {ref}"
      ],
      "exemplars": [
        "explain the card",
        "status of that card"
      ]
    },
    {
      "intent": "BoardApprove",
      "templates": [
        "approve {ref}"
      ],
      "exemplars": [
        "approve it",
        "yes approve"
      ]
    },
    {
      "intent": "BoardReject",
      "templates": [
        "reject {ref}"
      ],
      "exemplars": [
        "reject it",
        "no reject"
      ]
    },
    {
      "intent": "MemoryCorrect",
      "templates": [
        "remember [that] {note}",
        "แก้ไขด้วย",
        "จำไว้ว่า {note}",
        "จำไว้ {note}"
      ],
      "exemplars": [
        "fix that",
        "correct it",
        "that's wrong fix it",
        "แก้ไขหน่อย",
        "อย่าลืมนะ",
        "please update that"
      ]
    },
    {
      "intent": "ControlStop",
      "templates": [
        "(stop|cancel) [(it|that|now)]",
        "หยุด",
        "ยกเลิก",
        "พอแล้ว"
      ],
      "exemplars": [
        "stop that",
        "cancel it",
        "หยุดเลย",
        "ไม่ต้องแล้ว"
      ]
    },
    {
      "intent": "Greeting",
      "templates": [
        "(hi|hello|hey|yo) [(ada|there|kaewta)]",
        "สวัสดี [(ครับ|ค่ะ|จ้า|จ๊ะ)]",
        "ดีจ้า"
      ],
      "exemplars": [
        "good morning",
        "morning",
        "สวัสดีตอนเช้า",
        "ทักทาย"
      ]
    },
    {
      "intent": "Thanks",
      "templates": [
        "thank(s| you) [(ada|kaewta)]",
        "ขอบคุณ [(ครับ|ค่ะ|มาก|จ้า|นะ)]"
      ],
      "exemplars": [
        "thanks a lot",
        "cheers",
        "ขอบใจ",
        "thank you very much",
        "ขอบคุณจ้า"
      ]
    }
  ]
}