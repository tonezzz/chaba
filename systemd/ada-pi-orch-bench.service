[Unit]
Description=Orch topology bench (gemma-1b/4b structures) + nest-bench page refresh — tony-omen

[Service]
Type=oneshot
TimeoutStartSec=5400
WorkingDirectory=%h/CascadeProjects/ada-pi
# Travel-slim: gemma JEV scorers stay disabled; the weekly bench starts
# them on demand and stops them after (model load ~80s on CPU).
ExecStartPre=/bin/sh -c 'systemctl --user start open-jev open-jev-student; for i in $(seq 1 72); do curl -sf -m 3 http://100.75.102.88:8777/health >/dev/null && curl -sf -m 3 http://100.75.102.88:8778/health >/dev/null && exit 0; sleep 5; done; echo "open-jev endpoints did not become healthy"; exit 1'
ExecStartPost=/bin/sh -c 'systemctl --user stop open-jev open-jev-student; exit 0'
ExecStart=%h/.venvs/ada-voice-bench/bin/python tests/bench/orch-bench.py --student http://100.75.102.88:8778 --heavy http://100.75.102.88:8777 --mddb http://100.102.134.91:11023/v1 --report-cms
ExecStart=/usr/bin/python3 scripts/nest-bench-update.py --force
