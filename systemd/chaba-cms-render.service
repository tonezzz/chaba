[Unit]
Description=chaba-cms-render — live HTML surface for MDDB CMS plane (cms.surf-thailand.com)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# Dedicated venv (apps/cms-render/requirements.txt: fastapi uvicorn jinja2
# markdown). Install once:
#   python3 -m venv ~/.venvs/cms-render
#   ~/.venvs/cms-render/bin/pip install -r ~/CascadeProjects/chaba/apps/cms-render/requirements.txt
WorkingDirectory=%h/CascadeProjects/chaba/apps/cms-render
Environment=MDDB_CMS_URL=http://100.102.134.91:11027/v1
Environment=CMS_SITE_HOST=cms.surf-thailand.com
Environment=CMS_BIND_HOST=100.102.134.91
Environment=PORT=8010
ExecStart=%h/.venvs/cms-render/bin/python %h/CascadeProjects/chaba/apps/cms-render/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
