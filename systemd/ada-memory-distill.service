[Unit]
Description=Ada memory distill backstop (session summaries -> draft memory candidates)
# Hand-installed on idc03 (canonicalized 2026-11-27, vault-sync-gap card).
# Script runs from the synced ~/CascadeProjects/chaba checkout — chaba-vault
# is vault data only, its git clone is not synced.

[Service]
Type=oneshot
EnvironmentFile=%h/.config/secrets/tony-ha/backend.env
ExecStart=/usr/bin/python3 %h/CascadeProjects/chaba/scripts/ada/memory-distill.py --emit
