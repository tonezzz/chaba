[Unit]
Description=Sync clipboard from tony-dell to tony-omen (text + images)
After=network-online.target

[Service]
Type=simple
Environment="DISPLAY=:0" "XAUTHORITY=/home/tony/.Xauthority"
Environment="REMOTE_DISPLAY=:1" "REMOTE_XAUTHORITY=/home/tony/.Xauthority"
ExecStartPre=/bin/sh -c "for i in $(seq 60); do [ -S /tmp/.X11-unix/X0 ] && exit 0; sleep 2; done; exit 1"
ExecStart=/home/tony/.local/bin/clip-sync tony-dell
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
