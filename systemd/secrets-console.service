[Unit]
Description=Secrets Console (apps/secrets) — credential inventory, drift checks, login vault
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/CascadeProjects/chaba
Environment=BIND_HOST=100.68.142.13
Environment=PORT=8005
EnvironmentFile=-%h/.config/secrets/secrets-console.env
ExecStart=%h/CascadeProjects/ada-pi/.venv/bin/python %h/CascadeProjects/chaba/apps/secrets/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
