[Unit]
Description=Chaba CI/CD Pipeline Automation
After=network.target docker.service

[Service]
Type=oneshot
User=tony
ExecStart=/home/tony/CascadeProjects/chaba-tony-dell/scripts/ci-pipeline.sh all
WorkingDirectory=/home/tony/CascadeProjects/chaba-tony-dell
StandardOutput=append:/home/tony/CascadeProjects/chaba-tony-dell/logs/ci-pipeline.log
StandardError=append:/home/tony/CascadeProjects/chaba-tony-dell/logs/ci-pipeline.log

[Install]
WantedBy=multi-user.target