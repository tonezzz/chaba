[Unit]
Description=bge-rerank-server — warm bge-reranker-v2-m3 endpoint on GPU (MEM-1129)
# Persistent service — install on tony-omen (GPU lane) via:
#   cp systemd/bge-rerank.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now bge-rerank.service
# Requires ~/.local/share/chaba-ml-gpu-venv (R7 python_ml_gpu capability).
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/CascadeProjects/chaba
Environment=RERANK_ADDR=100.75.102.88:11555
Environment=RERANK_MODEL=BAAI/bge-reranker-v2-m3
Environment=RERANK_MAX_LEN=320
Environment=RERANK_AUTH_REQUIRED=1
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
EnvironmentFile=%h/.config/secrets/bge-rerank.env
ExecStart=%h/.local/share/chaba-ml-gpu-venv/bin/python %h/CascadeProjects/chaba/scripts/ada/bge-rerank-server.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
