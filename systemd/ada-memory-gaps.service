[Unit]
Description=Ada recall-miss gap report (journal misses -> draft gap notes)
# Hand-installed on idc03 (canonicalized 2026-11-27, vault-sync-gap card).
# Script runs from the synced ~/CascadeProjects/chaba checkout — chaba-vault
# is vault data only, its git clone is not synced.

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/CascadeProjects/chaba/scripts/ada/memory-gap-report.py --since "7 days ago" --emit
