[Unit]
Description=Chaba Monitoring Dashboard
After=network.target docker.service

[Service]
Type=simple
User=tony
Group=tony
ExecStart=/usr/bin/node /home/tony/CascadeProjects/chaba/scripts/monitoring-dashboard.mjs
WorkingDirectory=/home/tony/CascadeProjects/chaba
Restart=always
RestartSec=10
StandardOutput=append:/var/log/chaba-monitoring-dashboard.log
StandardError=append:/var/log/chaba-monitoring-dashboard.log

[Install]
WantedBy=multi-user.target