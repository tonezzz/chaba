[Unit]
Description=Chaba Overnight System Assessment
After=network.target

[Service]
Type=oneshot
User=tony
WorkingDirectory=/home/tony/CascadeProjects/chaba
ExecStart=/usr/bin/python3 /home/tony/CascadeProjects/chaba/scripts/orchestrate.py --workflow overnight --force
StandardOutput=append:/home/tony/CascadeProjects/chaba/logs/overnight-service.log
StandardError=append:/home/tony/CascadeProjects/chaba/logs/overnight-service.log