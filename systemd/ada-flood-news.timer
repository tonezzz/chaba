[Unit]
Description=Dispatcher tick — refresh automated CMS pages (flood news etc.) honoring per-page interval_min and run_now

[Timer]
# 15-min tick: the runner is idempotent (skips unchanged item sets) and
# per-page interval_min gates real work, so frequent ticks are cheap and
# keep queued run_now regenerations responsive (<= ~15 min latency).
OnBootSec=5min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
