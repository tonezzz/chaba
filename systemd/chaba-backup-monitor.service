[Unit]
Description=Chaba Backup Monitoring and Alerting
After=network.target

[Service]
Type=oneshot
User=tony
WorkingDirectory=/home/tony/CascadeProjects/chaba-tony-dell
ExecStart=/home/tony/CascadeProjects/chaba-tony-dell/scripts/backup-monitor.sh
StandardOutput=append:/var/log/chaba-backup-monitor.log
StandardError=append:/var/log/chaba-backup-monitor.log
