[Unit]
Description=Ada bank-recall drift report (journal scores -> chaba-events on tripwire)
# Runs on mn01 where ada-ha-* journal the recall scores.

[Service]
Type=oneshot
# Script runs from the synced ~/CascadeProjects/chaba checkout — chaba-vault is
# vault data only, its git clone is not synced (2026-11-27 vault-sync-gap).
ExecStart=/usr/bin/python3 %h/CascadeProjects/chaba/scripts/ada/recall-drift-report.py --since '7 days ago' --emit
