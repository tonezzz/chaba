[Unit]
Description=OpenCode models sync — provider map + profile allowlist drift check (job:opencode-models-sync, rendered from ssot.jobs.yml — do not edit)

[Service]
Type=oneshot
TimeoutStartSec=300
ExecStart=/usr/bin/python3 %h/CascadeProjects/chaba/scripts/devnest/sync-opencode-models.py --from-config %h/CascadeProjects/chaba/stacks/idc03/litellm/config.yaml --opencode %h/.config/opencode/opencode.json --profiles-root %h/CascadeProjects/chaba/evals/opencode-lane/profiles --write --alert
WorkingDirectory=%h/CascadeProjects/chaba
