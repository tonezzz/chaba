[Unit]
Description=Host-loads sampler (fleet load/mem/disk -> system-report monitor page) (job:chaba-host-loads, rendered from ssot.jobs.yml — do not edit)

[Service]
Type=oneshot
TimeoutStartSec=120
ExecStart=/usr/bin/python3 %h/CascadeProjects/chaba/scripts/host-loads.py
ExecStart=/bin/bash -c 'install -m644 %h/CascadeProjects/chaba/reports/host-loads/host-loads.yml %h/CascadeProjects/chaba/stacks/web/public/apps/system-report/data/host-loads.yml && install -m644 %h/CascadeProjects/chaba/reports/host-loads/host-loads.yml %h/web-srv/public/apps/system-report/data/host-loads.yml'
