[Unit]
Description=Log shipper (local journald -> MDDB host-logs) (job:log-shipper, rendered from ssot.jobs.yml — do not edit)

[Service]
Type=oneshot
TimeoutStartSec=600
ExecStart=/usr/bin/python3 %h/.local/share/log-shipper/log-shipper.py --self --max-docs 2000
Environment="MDDB_BASE_URL=http://100.102.134.91:11023/v1"
Environment="MDDB_OPS_URL=http://100.102.134.91:11026/v1"
