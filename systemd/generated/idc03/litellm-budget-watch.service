[Unit]
Description=LiteLLM budget watch — near-cap warn/alert per virtual key (job:litellm-budget-watch, rendered from ssot.jobs.yml — do not edit)
ConditionPathExists=%h/CascadeProjects/chaba/scripts/litellm/budget-watch.py

[Service]
Type=oneshot
TimeoutStartSec=300
ExecStart=/usr/bin/python3 %h/CascadeProjects/chaba/scripts/litellm/budget-watch.py
WorkingDirectory=%h/CascadeProjects/chaba
EnvironmentFile=%h/.config/secrets/litellm.env
