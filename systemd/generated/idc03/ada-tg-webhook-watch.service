[Unit]
Description=Ada Telegram webhook registration monitor (job:ada-tg-webhook-watch, rendered from ssot.jobs.yml — do not edit)

[Service]
Type=oneshot
TimeoutStartSec=30
ExecStart=/usr/bin/python3 %h/CascadeProjects/chaba/scripts/ops/telegram-webhook-watch.py
EnvironmentFile=%h/.config/secrets/telegram-bot.env
Environment="BOARD_NOTIFY_CHANNEL=tg"
Environment="BOARD_NOTIFY_TG_CHAT_ID=-5410424865"
Environment="TELEGRAM_EXPECTED_WEBHOOK_URL=https://api.surf-thailand.com/webhook/tg"
