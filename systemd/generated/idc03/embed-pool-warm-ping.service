[Unit]
Description=Embed pool warm-ping — keep bge-m3 loaded on ollama upstreams (job:embed-pool-warm-ping, rendered from ssot.jobs.yml — do not edit)
ConditionPathExists=%h/CascadeProjects/chaba/scripts/nest/embed-pool-warm-ping.py

[Service]
Type=oneshot
TimeoutStartSec=300
ExecStart=/usr/bin/python3 %h/CascadeProjects/chaba/scripts/nest/embed-pool-warm-ping.py
WorkingDirectory=%h/CascadeProjects/chaba
