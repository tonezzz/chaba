[Unit]
Description=Embed lane — news title vectors (nomic) refresh (job:embed-lane-news, rendered from ssot.jobs.yml — do not edit)
ConditionPathExists=%h/CascadeProjects/chaba/scripts/embed/embed-lane.py

[Service]
Type=oneshot
TimeoutStartSec=300
ExecStart=/usr/bin/python3 %h/CascadeProjects/chaba/scripts/embed/embed-lane.py news --dir %h/.local/share/embed-lane --hours 26
WorkingDirectory=%h/CascadeProjects/chaba
EnvironmentFile=%h/.config/secrets/litellm-chaba.env
