[Unit]
Description=R7 host software readiness probe (job:chaba-host-ready-check, rendered from ssot.jobs.yml — do not edit)
ConditionPathExists=%h/CascadeProjects/chaba/scripts/host-ready-check.py

[Service]
Type=oneshot
TimeoutStartSec=600
ExecStart=/usr/bin/python3 %h/CascadeProjects/chaba/scripts/host-ready-check.py --json-out %h/var/chaba/jobs/host-ready-check.json
WorkingDirectory=%h/CascadeProjects/chaba
