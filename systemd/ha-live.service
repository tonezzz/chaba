[Unit]
Description=Home Assistant Gemini Live bridge
After=tony-ha.service
Requires=tony-ha.service

[Service]
Type=simple
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/podman exec tony-ha pkill -9 -f "python3 /config/ha-live/bridge.py"
ExecStart=/usr/bin/podman exec -i tony-ha python3 /config/ha-live/bridge.py
ExecStopPost=-/usr/bin/podman exec tony-ha pkill -9 -f "python3 /config/ha-live/bridge.py"

[Install]
WantedBy=default.target
