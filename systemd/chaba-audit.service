[Unit]
Description=Chaba audit suite (kb, ssot, security)
After=network.target

[Service]
Type=oneshot
User=tony
Environment=MDDB_BASE=http://localhost:11023
Environment=MDDB_DB_PATH=/home/tony/.config/containers/mddb/data/mddb.db
ExecStart=/home/tony/.n/bin/node /home/tony/CascadeProjects/chaba-tony-dell/scripts/audits/run.mjs
WorkingDirectory=/home/tony/CascadeProjects/chaba-tony-dell
StandardOutput=append:/home/tony/CascadeProjects/chaba-tony-dell/logs/audit-suite.log
StandardError=append:/home/tony/CascadeProjects/chaba-tony-dell/logs/audit-suite.log
