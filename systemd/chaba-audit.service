[Unit]
Description=Chaba audit suite (kb, ssot, security)
After=network.target

[Service]
Type=oneshot
User=tony
ExecStart=/usr/bin/node /home/tony/CascadeProjects/chaba/scripts/audits/run.mjs
WorkingDirectory=/home/tony/CascadeProjects/chaba
StandardOutput=append:/home/tony/CascadeProjects/chaba/logs/audit-suite.log
StandardError=append:/home/tony/CascadeProjects/chaba/logs/audit-suite.log
