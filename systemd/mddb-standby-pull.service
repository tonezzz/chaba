[Unit]
Description=Pull nightly MDDB backup from idc03 -> refresh tony-dell standby db
# Source: idc03 nightly backup (mddb-YYYYMMDD-HHMM.db) — native /v1/backup
# on mddb >=2.15.4 is consistent + self-verified (upstream PR #281), so
# the pulled file is restorable. The old "native backup is corrupt /
# filecopy-only" note applied to <2.15.4 and the mddb-filecopy-* tier on
# idc01 — that producer died with the idc01 cutover (last file Oct 3).
# mddb.service stays DISABLED on this host (standby only).
# filecopy/ retention: newest 1 local only — older snapshots are moved to
# gdrive:backups/mddb/ via rclone (added 2026-10-07 — local disk pressure;
# rclone move deletes the source only after a verified upload, so a
# failed push leaves the file in place and fails the unit = visible).
# Install: cp to ~/.config/systemd/user/ + daemon-reload (installed copy
# is authoritative — this file is the SSOT mirror).

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -c 'rsync -az --timeout=60 --include="mddb-2*.db" --exclude="*" idc03:mddb-backups/ %h/.local/share/mddb-backups/filecopy/ && latest=$(ls -t %h/.local/share/mddb-backups/filecopy/mddb-2*.db 2>/dev/null | head -n1) && test -n "$latest" && { systemctl --user is-active --quiet mddb.service || podman unshare cp "$latest" %h/.config/containers/mddb/data/mddb.db; } && ls -t %h/.local/share/mddb-backups/filecopy/mddb-2*.db | tail -n +2 | xargs -r -I{} rclone move {} gdrive:backups/mddb/ --transfers=1'
