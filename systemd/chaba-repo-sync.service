[Unit]
Description=Sync chaba checkout (git pull --rebase --autostash) — repo-exec jobs depend on current code; also refreshes ~/.local/bin runner tooling via sync-runner-tools.sh

[Service]
Type=oneshot
WorkingDirectory=%h/CascadeProjects/chaba
ExecStart=/usr/bin/bash %h/CascadeProjects/chaba/scripts/git-safe-pull.sh
TimeoutStartSec=300
