+# mddb's early health listener answers /health + /v1/health during startup
+# but 404s every other route until 'mddb HTTP listening' — ~104s observed
+# after an OOM-kill restart on idc03 (2026-11-27). Gate posts on that
+# signal; /add keys are deterministic upserts so a retried write is
+# idempotent (card mddb-idc03-oom-coldstart-publisher-window).
+READY_BUDGET_S = 200
+READY_POLL_S = 5
+
+_TRANSPORT_ERRORS = (
+    urllib.error.URLError,
+    http.client.RemoteDisconnected,
+    http.client.IncompleteRead,
+    ConnectionResetError,
+    ConnectionAbortedError,
+    TimeoutError,
+)
+
+
+def _healthy(base, timeout=5):
+    try:
+        with urllib.request.urlopen(base + "/health", timeout=timeout) as r:
+            return r.status == 200
+    except Exception:
+        return False
+
+
+def wait_ready(base, budget=READY_BUDGET_S):
+    """Poll {base}/health until ready or the budget expires."""
+    deadline = time.time() + budget
+    while time.time() < deadline:
+        if _healthy(base):
+            return True
+        time.sleep(READY_POLL_S)
+    return _healthy(base)
+
+
