+                if gate is not None:
+                    status, gout = gate
+                    return JSONResponse(gout, status_code=status)
+            elif intent and intent != "reply":
+                return JSONResponse(
+                    {"ok": False,
+                     "error": f"unknown intent '{intent}'"},
+                    status_code=400)
             if body.get("image_url"):
                 msgs += await self._image_msgs(
                     str(body["image_url"]), str(body.get("caption") or ""))
