+    # -- member directory: name -> userId resolution for /send --
+
+    def _member_note(self, user_id: str, name: str) -> None:
+        """Persist userId -> display name to MEMBERS_FILE — the
+        directory /send to=/mention= resolves through on later sends,
+        restarts included. Only real display names land here (profile
+        fetches, the first-seen registry) — caller-key fallbacks are not
+        directory material."""
+        name = str(name or "").strip()
+        if not name or not user_id.startswith("U"):
+            return
+        if not self._member_dir_loaded:
+            self._member_dir_load()
+        if self._member_dir.get(user_id) == name:
+            return
+        self._member_dir[user_id] = name
+        try:
+            MEMBERS_FILE.parent.mkdir(parents=True, exist_ok=True)
+            MEMBERS_FILE.write_text(json.dumps(
+                self._member_dir, sort_keys=True))
+        except Exception:
+            logger.info("member-dir save failed")
+
+    def _member_dir_load(self) -> None:
+        self._member_dir_loaded = True
+        try:
+            if MEMBERS_FILE.is_file():
+                data = json.loads(MEMBERS_FILE.read_text())
+                if isinstance(data, dict):
+                    self._member_dir.update(
+                        {str(k): str(v) for k, v in data.items()})
+                    logger.info("member dir loaded: %d name(s)",
+                                len(self._member_dir))
+        except Exception:
+            logger.info("member-dir load failed")
+
+    async def _registry_scan(self) -> dict[str, str]:
+        """lowered display_name/caller -> userId from the mddb
+        line-user-registry — the fallback for a name the local
+        directory doesn't know (member predates MEMBERS_FILE). Cached
+        for LINE_REGISTRY_LOOKUP_TTL_S so a run of unknown names can't
+        hammer mddb; the scan is a bounded listing, not per-doc gets."""
+        if self._reg_lookup_at and time.monotonic() - \
+                self._reg_lookup_at < LINE_REGISTRY_LOOKUP_TTL_S:
+            return self._reg_lookup
+        self._reg_lookup_at = time.monotonic()
+        mddb = _registry_store()
+        if mddb is None:
+            return self._reg_lookup
+        try:
+            docs = await mddb.search_documents(
+                LINE_REGISTRY_COLL, limit=500)
+            out: dict[str, str] = {}
+            for d in docs or []:
+                uid = str(d.get("key") or "")
+                meta = d.get("meta") or {}
+                for field in ("display_name", "caller"):
+                    for n in meta.get(field) or []:
+                        n = str(n).strip().lower()
+                        if n and uid:
+                            out.setdefault(n, uid)
+            self._reg_lookup = out
+        except Exception as exc:
+            logger.info("registry lookup scan failed: %s", exc)
+        return self._reg_lookup
+
+    async def _member_uid(self, name: str) -> str:
+        """Resolve a member display name / caller / alias to a LINE
+        userId — the /send to= and mention= chain. Order: 'owner'/'me'
+        alias, the _names label cache, LINE_USER_CALLERS,
+        LINE_PERSON_ALIASES, the persisted MEMBERS_FILE directory, then
+        one throttled mddb registry scan. '' when nothing knows the
+        name — the caller decides whether to error or let LINE 400."""
+        lookup = str(name or "").strip().lower()
+        if not lookup:
+            return ""
+        if lookup.startswith("person."):
+            lookup = lookup.split(".", 1)[1]
+        if lookup in ("owner", "me"):
+            # 'owner' is a standing alias — lanes saying to=owner mean
+            # the relay owner, not a literal id.
+            return next(iter(_allowed_users()), "")
+        hit = next((k for k, v in self._names.items()
+                    if v.lower() == lookup), "")
+        if not hit:
+            hit = next((u for u, n in _user_callers().items()
+                        if n.lower() in (lookup, f"user-{lookup}")), "")
+        if not hit:
+            # LINE_PERSON_ALIASES="tony=user-tonezzzz,kk=user-kk"
+            aliases = dict(p.split("=", 1) for p in
+                           os.environ.get("LINE_PERSON_ALIASES",
+                                          "").split(",") if "=" in p)
+            target = aliases.get(lookup, "")
+            if target:
+                hit = next((u for u, n in _user_callers().items()
+                            if n.lower() == target.lower()), "")
+        if not hit:
+            self._member_dir_load()
+            hit = next((u for u, n in self._member_dir.items()
+                        if n.lower() == lookup), "")
+        if not hit:
+            hit = (await self._registry_scan()).get(lookup, "")
+        return hit
+
+    # -- proactive sends: mention build + policy gate --
+
+    @staticmethod
+    def _u16len(s: str) -> int:
+        """LINE mention index/length are UTF-16 code-unit offsets —
+        len() undercounts astral chars (emoji, some Thai text)."""
+        return len(s.encode("utf-16-le")) // 2
+
+    async def _mention_wrap(self, text: str, names: list[str],
+                            chat_id: str) -> tuple[str, list, list]:
+        """Prepend '@display ' placeholders to a room-bound text and
+        build LINE's mention object. Returns (text, mentionees,
+        member_uids) — each mentionee is {index, length, type:'user',
+        userId} with positions in UTF-16 code units. Display names come
+        from the per-member group/room profile endpoint, falling back
+        to the caches/directory. A name that resolves nowhere raises
+        ValueError — the send aborts rather than dropping a ping the
+        model believes it made."""
+        kind = "room" if chat_id.startswith("R") else "group"
+        prefix, mentionees, uids = "", [], []
+        for name in names[:4]:
+            uid = name if re.match(r"^U[0-9a-f]{10,}$", name) \
+                else await self._member_uid(name)
+            if not uid.startswith("U"):
+                raise ValueError(
+                    f"unknown member '{name}' — cannot address the "
+                    "mention (not in callers, member dir, or registry)")
+            disp = await self._fetch_profile_name(uid, chat_id, kind) \
+                or self._names.get(uid) \
+                or self._member_dir.get(uid) or name.lstrip("@")
+            tag = f"@{disp}"
+            mentionees.append({"index": self._u16len(prefix),
+                               "length": self._u16len(tag),
+                               "type": "user", "userId": uid})
+            uids.append(uid)
+            prefix += tag + " "
+        return prefix + text, mentionees, uids
+
+    def _proactive_load(self) -> None:
+        if self._proactive_loaded:
+            return
+        self._proactive_loaded = True
+        try:
+            if PROACTIVE_STATE_FILE.is_file():
+                data = json.loads(PROACTIVE_STATE_FILE.read_text())
+                if isinstance(data, dict):
+                    for k in ("last", "member_last", "counts"):
+                        if isinstance(data.get(k), dict):
+                            self._proactive[k].update(
+                                {str(a): b for a, b in data[k].items()})
+                    self._proactive["day"] = str(data.get("day") or "")
+                    logger.info("proactive state loaded: %d lane(s)",
+                                len(self._proactive["last"]))
+        except Exception:
+            logger.info("proactive-state load failed")
+
+    def _proactive_save(self) -> None:
+        try:
+            PROACTIVE_STATE_FILE.parent.mkdir(parents=True,
+                                              exist_ok=True)
+            PROACTIVE_STATE_FILE.write_text(json.dumps(
+                self._proactive, sort_keys=True))
+        except Exception:
+            logger.info("proactive-state save failed")
