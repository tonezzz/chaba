+    def _proactive_gate(self, inst: str, chat_id: str,
+                        member_ids: list[str]) -> tuple[int, dict] | None:
+        """Policy for intent='proactive' /send payloads (card
+        line-proactive-persona). None = pass, else (status, body) the
+        endpoint answers. Rules:
+          - the instance must sit in LINE_PROACTIVE_ALLOW — the
+            backend-declared intent still needs an allowlisted lane;
+          - one proactive send per (instance, chat) per
+            LINE_PROACTIVE_DEBOUNCE_S, and the same gap per engaged
+            member (DM target or mention) — a persona can't evade the
+            room debounce by rotating targets;
+          - LINE_PROACTIVE_DAY_CAP per (instance, chat) per day.
+        Passing records the send: timestamps, day counter, a ledger
+        proactive_msgs tick and a proactive_sent ops event, all
+        write-through so a restart keeps the limits."""
+        self._proactive_load()
+        now = time.time()
+        if inst not in LINE_PROACTIVE_ALLOW:
+            _ops_event("proactive_denied", "warn", instance=inst,
+                       chat_id=chat_id, reason="allowlist")
+            logger.warning("proactive send denied: instance %r not in "
+                           "LINE_PROACTIVE_ALLOW", inst)
+            return 403, {"ok": False,
+                         "error": f"proactive sends are not enabled for "
+                                  f"instance '{inst or '(none)'}' — the "
+                                  "lane needs LINE_PROACTIVE_ALLOW on "
+                                  "the relay"}
+        day = datetime.now().strftime("%Y-%m-%d")
+        if self._proactive.get("day") != day:
+            self._proactive["day"] = day
+            self._proactive["counts"] = {}
+        key = f"{inst}|{chat_id}"
+        gap = LINE_PROACTIVE_DEBOUNCE_S - (
+            now - float(self._proactive["last"].get(key) or 0))
+        if gap > 0:
+            _ops_event("proactive_debounced", "info", instance=inst,
+                       chat_id=chat_id, retry_in_s=int(gap))
+            return 429, {"ok": False, "debounced": True,
+                         "retry_in_s": int(gap),
+                         "error": f"proactive debounce — wait "
+                                  f"{int(gap)}s before this lane pings "
+                                  "this chat again"}
+        for mid in member_ids:
+            mgap = LINE_PROACTIVE_DEBOUNCE_S - (
+                now - float(
+                    self._proactive["member_last"].get(
+                        f"{inst}|{mid}") or 0))
+            if mgap > 0:
+                _ops_event("proactive_debounced", "info", instance=inst,
+                           member=mid, retry_in_s=int(mgap))
+                return 429, {"ok": False, "debounced": True,
+                             "retry_in_s": int(mgap),
+                             "error": "proactive debounce — this member "
+                                      "was engaged less than "
+                                      f"{int(LINE_PROACTIVE_DEBOUNCE_S)}s "
+                                      "ago"}
+        used = int(self._proactive["counts"].get(key) or 0)
+        if used >= LINE_PROACTIVE_DAY_CAP:
+            _ops_event("proactive_denied", "warn", instance=inst,
+                       chat_id=chat_id, reason="day-cap", used=used)
+            return 429, {"ok": False,
+                         "error": f"daily proactive cap reached for this "
+                                  f"chat ({used}/"
+                                  f"{LINE_PROACTIVE_DAY_CAP}) — park the "
+                                  "thought until tomorrow"}
+        self._proactive["last"][key] = now
+        for mid in member_ids:
+            self._proactive["member_last"][f"{inst}|{mid}"] = now
+        self._proactive["counts"][key] = used + 1
+        self._ledger_add(proactive_msgs=1)
+        self._proactive_save()
+        _ops_event("proactive_sent", "info", instance=inst,
+                   chat_id=chat_id, members=member_ids or None,
+                   day_used=used + 1)
+        return None
