+    async def _chat_send_page(self, slug: str, *, channel: str,
+                              text: str, to: str,
+                              say: str = "") -> dict[str, Any]:
+        """page= flow (card chat-send-page-images): same 'queued'
+        contract as a plain send — the mddb read + per-asset delivery
+        happen in the background job and the outcome lands as a system
+        note."""
+        import asyncio
+        import secrets
+        job_id = "chat-" + secrets.token_hex(4)
+        asyncio.create_task(self._chat_send_page_run(
+            job_id, slug, channel=channel, text=text, to=to, say=say))
+        return {"status": "queued", "job_id": job_id, "channel": channel,
+                "page": slug,
+                "note": "Reading the page and sending its images in the "
+                        "background — a system note will report "
+                        "sent/failed per asset when it finishes."}
+
+    async def _chat_send_page_run(self, job_id: str, slug: str,
+                                  channel: str, text: str, to: str,
+                                  say: str = "") -> None:
+        """cms_get_page the slug, extract every embedded image, push the
+        batch through the relay /send image_urls contract. Per-asset
+        sent/failed comes back in the relay's 'images' report — the
+        summary note stays honest instead of narrating a count it never
+        verified."""
+        import urllib.request
+        summary_bits: list[str] = []
+        ok_any = False
+        try:
+            doc = await self.cms_get_page(slug)
+        except Exception as exc:
+            doc = {"ok": False, "error": f"{type(exc).__name__}: {exc}"}
+        if not isinstance(doc, dict) or doc.get("ok") is False \
+                or doc.get("error"):
+            err = (doc or {}).get("error") or "page read failed"
+            await self._chat_notify(
+                job_id, False,
+                [f"page '{slug}': {err} — nothing sent"])
+            return
+        title = str(doc.get("title") or slug)
+        urls, skipped = _page_image_urls(
+            str(doc.get("content") or ""), _chat_page_img_max())
+        if skipped:
+            summary_bits.append(
+                f"{skipped} page assets over the "
+                f"{_chat_page_img_max()}-image cap — not sent")
+        text = str(text or "")
+        if not urls and not text.strip():
+            summary_bits.append(f"page '{slug}' embeds no images")
+            await self._chat_notify(job_id, False, summary_bits)
+            return
+        if not urls:
+            summary_bits.append(f"page '{slug}' embeds no images")
+        relays = [c for c in (channel or "line").lower().split(",")
+                  if c.strip()]
+        if "both" in relays or "all" in relays:
+            relays = ["line", "telegram"]
+        audio_b64, duration_ms = await self._chat_say_audio(
+            say, relays, summary_bits)
+        for svc in relays:
+            svc = svc.strip()
+            if svc == "web":
+                tgt = (str(to or "").strip()
+                       or session_chat_id(self, "web"))
+                if text.strip():
+                    res = await self._chat_send_web(
+                        tgt, text=text, image_url="", video_url="")
+                    if res.get("ok"):
+                        ok_any = True
+                    else:
+                        summary_bits.append(
+                            f"web: text failed ({res.get('error', '?')})")
+                sent = 0
+                for u in urls:
+                    r = await self._chat_send_web(
+                        tgt, text="", image_url=u, video_url="")
+                    if r.get("ok"):
+                        sent += 1
+                        ok_any = True
+                    else:
+                        summary_bits.append(
+                            f"web: failed {u} ({r.get('error', '?')})")
+                if urls:
+                    summary_bits.append(
+                        f"web: {sent}/{len(urls)} images delivered")
+                continue
+            if svc == "line":
+                ep = os.environ.get("ADA_LINE_SEND_URL",
+                                    "http://127.0.0.1:8912/send")
+            elif svc in ("telegram", "tg"):
+                ep = os.environ.get("ADA_TG_SEND_URL",
+                                    "http://127.0.0.1:8911/send")
+            else:
+                summary_bits.append(f"unknown channel '{svc}'")
+                continue
+            # In-context default: a bare chat_send answers in the chat
+            # the turn came from (session ?chat_id= binding), not the
+            # lane's default room — an explicit to= still wins.
+            to_eff = str(to or "").strip()
+            if not to_eff:
+                to_eff = session_chat_id(
+                    self, "telegram" if svc in ("telegram", "tg") else svc)
+            payload = {"text": text, "image_urls": urls,
+                       "caption": text or title, "to": to_eff,
+                       "chat_id": to_eff,
+                       "instance": os.environ.get(
+                           "ADA_INSTANCE_ID", "")}
+            if audio_b64 and svc in ("line", "telegram", "tg"):
+                payload.update({"audio_b64": audio_b64,
+                                "audio_mime": "audio/wav",
+                                "duration_ms": duration_ms})
+            try:
+                req = urllib.request.Request(
+                    ep, data=json.dumps(payload).encode(),
+                    headers={"Content-Type": "application/json"})
+                with urllib.request.urlopen(req, timeout=150) as r:
+                    res = json.load(r)
+                if not res.get("ok"):
+                    summary_bits.append(
+                        f"{svc}: failed ({res.get('error', '?')})")
+                    continue
+                ok_any = True
+                imgs = res.get("images")
+                if not isinstance(imgs, list) or not imgs:
+                    # Old relay without the batch report — the push
+                    # landed but per-asset detail is unknown.
+                    summary_bits.append(
+                        f"{svc}: delivered ({len(urls)} assets, "
+                        "no per-asset report)")
+                    continue
+                sent = sum(1 for i in imgs
+                           if i.get("status") == "delivered")
+                parked = sum(1 for i in imgs
+                             if i.get("status") == "parked")
+                bit = f"{svc}: {sent}/{len(urls)} images delivered"
+                if parked:
+                    bit += f", {parked} parked"
+                summary_bits.append(bit)
+                for i in imgs:
+                    if i.get("status") not in ("delivered", "parked"):
+                        summary_bits.append(
+                            f"{svc}: failed {i.get('url')} "
+                            f"({i.get('status') or 'error'})")
+            except Exception as exc:
+                summary_bits.append(f"{svc}: failed ({exc})")
+        await self._chat_notify(job_id, ok_any, summary_bits)
