+    async def _chat_say_audio(self, say: str, relays: list[str],
+                              summary_bits: list[str]
+                              ) -> tuple[str, int]:
+        """say= voice note -> (wav_b64, duration_ms) for line/tg
+        payloads; notes + skips channels that can't carry audio."""
+        say_text = str(say or "").strip()
+        if not say_text:
+            return "", 0
+        if not ("line" in relays or "telegram" in relays
+                or "tg" in relays):
+            summary_bits.append("voice: line/telegram only — skipped")
+            return "", 0
+        try:
+            from backend import tts as ada_tts
+            pcm = await ada_tts.synth_pcm(
+                say_text, mddb=self.mddb, tool="chat_send_say",
+                session_id=str(self.session_id or ""))
+            if pcm:
+                import base64 as _b64
+                return (_b64.b64encode(ada_tts.pcm_to_wav(pcm)).decode(),
+                        ada_tts.pcm_duration_ms(pcm))
+            summary_bits.append("voice: tts failed (text only)")
+        except Exception as exc:
+            summary_bits.append(f"voice: tts error ({exc})")
+        return "", 0
