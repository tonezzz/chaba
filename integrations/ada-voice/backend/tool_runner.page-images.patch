 from .common import *  # noqa: F401,F403
 
+# chat_send page= mode (card chat-send-page-images): markdown image
+# syntax and HTML <img src> — every asset a CMS page embeds.
+_PAGE_IMG_MD_RE = re.compile(
+    r"!\[[^\]]*\]\(\s*<?([^)\s>]+)>?(?:\s+[\"'][^\"')]*[\"'])?\s*\)")
+_PAGE_IMG_TAG_RE = re.compile(
+    r"<img\b[^>]*?\bsrc\s*=\s*[\"']([^\"']+)[\"']", re.I)
+
+
+def _chat_page_img_max() -> int:
+    try:
+        return max(1, int(os.environ.get("ADA_CHAT_PAGE_IMG_MAX", "10")))
+    except (TypeError, ValueError):
+        return 10
+
+
+def _page_image_urls(content: str, limit: int) -> tuple[list[str], int]:
+    """Every image asset embedded in a CMS page body -> absolute fetch
+    URLs, document order, dupes dropped. Absolute http(s) pass through;
+    //host goes https; site-relative paths (/api/documents/x.jpg, bare
+    'media/x.jpg') resolve against LINE_URL_BASE — the same base the
+    relay resolves them against at fetch time. data: URIs are skipped.
+    Returns (urls[:limit], skipped_over_cap)."""
+    base = os.environ.get(
+        "LINE_URL_BASE", "http://100.102.134.91:11023").rstrip("/")
+    matches = [*_PAGE_IMG_MD_RE.finditer(content or ""),
+               *_PAGE_IMG_TAG_RE.finditer(content or "")]
+    matches.sort(key=lambda m: m.start())
+    urls: list[str] = []
+    for m in matches:
+        u = m.group(1).strip()
+        if not u or u.startswith("data:"):
+            continue
+        if u.startswith("//"):
+            u = "https:" + u
+        elif u.startswith("/"):
+            u = base + u
+        elif not u.startswith(("http://", "https://")):
+            u = base + "/" + u.lstrip("/")
+        if u not in urls:
+            urls.append(u)
+    return urls[:limit], max(0, len(urls) - limit)
+
 
