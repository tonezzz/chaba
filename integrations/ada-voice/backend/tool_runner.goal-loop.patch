+    # -- cross-tool goal loop --------------------------------------------
+
+    def _goal_loop(self, name: str, result: Any) -> Any:
+        """Attach a stop_and_ask directive when actuating calls keep
+        failing (card ada-cast-wrong-target-verbose-loop). The storm
+        breaker trips per tool+error-class; a failing user goal wanders
+        ACROSS tools — 2026-10-14 session 4029a6447f looped 'send GEV to
+        the TV' through cast_to_screen x2, control_entity and tv_action
+        while no single tool tripped, and Ada narrated each miss at
+        length. GOAL_LOOP_ASK consecutive counted failures on
+        CONTROL_TOOLS in one session scope earn the directive — 'tell
+        the user it fails and ask', not a hard block: an explicit 'try
+        again' stays legal. A clean or uncounted actuating result clears
+        the streak."""
+        if name not in CONTROL_TOOLS or not isinstance(result, dict):
+            return result
+        if result.get("circuit_open"):
+            return result  # the storm breaker already spoke
+        cls = _storm_error_class(result)
+        scope = self._storm_scope()
+        loops = self.__dict__.setdefault("_goal_loops", {})
+        if cls is None:
+            # A landed action — or a gate asking the user (needs_confirm
+            # classifies uncounted) — ends the streak: the loop was
+            # either fixed or correctly handed to the user.
+            loops.pop(scope, None)
+            return result
+        now = time.monotonic()
+        hits = [t for t in loops.get(scope, [])
+                if now - t < GOAL_LOOP_WINDOW_S]
+        hits.append(now)
+        loops[scope] = hits
+        if len(hits) >= GOAL_LOOP_ASK:
+            result = dict(result)
+            result["stop_and_ask"] = (
+                f"{len(hits)} action attempts in a row failed this "
+                f"session (latest: {name}). STOP — do not try another "
+                "tool, target, or phrasing on your own: tell the user "
+                "in ONE short sentence what is failing and ask what "
+                "they want; stay terse until they give a fresh "
+                "instruction.")
+            logger.warning(
+                "goal loop: %d consecutive actuating failures scope=%s "
+                "(latest %s) — stop_and_ask attached",
+                len(hits), scope, name)
+        return result
+
