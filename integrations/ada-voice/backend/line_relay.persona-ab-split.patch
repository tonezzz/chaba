+def _caller_backends() -> dict[tuple[str, str | None], str]:
+    """LINE_CALLER_BACKENDS -> {(caller, persona|None): ws_url}.
+    Per-caller backend overrides — the split-A/B mechanism (card
+    persona-ab-split-routing-relay): route one sender's turns to a
+    variant backend while the rest of the lane stays on the
+    LINE_NAME_BACKENDS pointer. 'caller=url' applies to every persona
+    that caller addresses; 'caller@persona=url' scopes the override
+    to one lane. Caller keys are LINE_USER_CALLERS names; a leading
+    'user-' is stripped on both sides so 'kk' and 'user-kk' match."""
+    out: dict[tuple[str, str | None], str] = {}
+    for part in os.environ.get("LINE_CALLER_BACKENDS", "").split(","):
+        part = part.strip()
+        if "=" not in part:
+            continue
+        who, _, url = part.partition("=")
+        who, url = who.strip().lower(), url.strip()
+        if not who or not url:
+            continue
+        caller, _, persona = who.partition("@")
+        caller = re.sub(r"^user-", "", caller.strip())
+        if not caller:
+            continue
+        if re.match(r"^wss?://[^/]+$", url):
+            url += "/ws"
+        out[(caller, persona.strip() or None)] = url
+    return out
+
+
+def _backend_url(caller: str | None, persona: str) -> str:
+    """Backend ws url for a turn. A LINE_CALLER_BACKENDS override for
+    this caller — persona-scoped first, then lane-wide — beats the
+    whole-lane LINE_NAME_BACKENDS pointer. Returns "" when the persona
+    is unknown or known-but-offline, same as _name_backends().get."""
+    if caller:
+        key = re.sub(r"^user-", "", caller).strip().lower()
+        ov = _caller_backends()
+        url = ov.get((key, persona)) or ov.get((key, None))
+        if url:
+            return url
+    return _name_backends().get(persona) or ""
+
