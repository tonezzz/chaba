+_KINDS = ("post", "expense", "contact", "reminder", "asset")
+
+# Meta keys the chaba-boards plugin registered REST-writable per CPT
+# (integrations/wp-boards/chaba-boards.php) — anything else in meta= is
+# dropped and reported, never sent.
+_KIND_META = {
+    "expense": ("amount", "currency", "vendor", "paid_by",
+                "receipt_date"),
+    "contact": ("phone", "line_id", "role"),
+    "reminder": ("due_date", "assignee"),
+    "asset": ("model", "serial", "purchase_date", "warranty_until",
+              "vendor"),
+}
+
+# "<Kind> — <name>" title standard (ssot.wp-boards.yml title_standard).
+_KIND_LABEL = {"expense": "Expense", "contact": "Contact",
+               "reminder": "Reminder", "asset": "Asset"}
+
+_OCR_MODEL = os.environ.get("ADA_WP_OCR_MODEL",
+                            "gemini-3.5-flash-lite")
+_OCR_MAX_BYTES = int(os.environ.get("ADA_WP_OCR_MAX_BYTES",
+                                    str(8 * 1024 * 1024)))
+_OCR_PROMPT = (
+    "This is a photo of a receipt, invoice or payment slip. Reply with "
+    "ONLY a JSON object, no prose and no code fences: {\"amount\": "
+    "\"123.45\" or null, \"currency\": \"THB\"/\"USD\"/etc or null, "
+    "\"vendor\": \"shop or issuer name\" or null, \"receipt_date\": "
+    "\"YYYY-MM-DD\" or null, \"paid_by\": \"payer name if shown\" or "
+    "null}.")
+
+
+async def _ocr_receipt(runner: Any, path: str) -> dict[str, str]:
+    """Pull expense fields out of an archived receipt photo/PDF via the
+    lane's Gemini pool. Best-effort: any failure returns {} and the post
+    lands with whatever meta the caller supplied."""
+    try:
+        with open(path, "rb") as fh:
+            data = fh.read(_OCR_MAX_BYTES + 1)
+    except OSError:
+        return {}
+    if not data or len(data) > _OCR_MAX_BYTES:
+        return {}
+    mime, _ext = wp.sniff_media(path)
+    if not (mime.startswith("image/") or mime == "application/pdf"):
+        return {}
+    try:
+        from google.genai import types
+        ctx = getattr(runner, "context", None)
+        resp = await gemini_pool.generate(
+            model=_OCR_MODEL,
+            contents=[
+                types.Part.from_bytes(data=data, mime_type=mime),
+                _OCR_PROMPT,
+            ],
+            tool="wp_post",
+            mddb=getattr(ctx, "mddb", None),
+            session_id=str(getattr(ctx, "session_id", "") or "runner"),
+            timeout=45.0)
+    except Exception:
+        return {}
+    text = (getattr(resp, "text", None) or "").strip()
+    m = re.search(r"\{.*\}", text, re.S)
+    if not m:
+        return {}
+    try:
+        obj = json.loads(m.group(0))
+    except ValueError:
+        return {}
+    if not isinstance(obj, dict):
+        return {}
+    return {k: str(v).strip() for k, v in obj.items()
+            if v is not None and str(v).strip()}
+
 
