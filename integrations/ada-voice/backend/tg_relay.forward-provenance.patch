+def _forwarder_name(msg: dict) -> str:
+    """The carrying user's best label — mapped caller first, then their
+    TG display name — for forwards whose origin is hidden."""
+    sender = msg.get("from") or {}
+    return str(_user_callers().get(sender.get("id"))
+               or sender.get("first_name") or sender.get("username")
+               or "the forwarder")
+
+
+def _media_desc(msg: dict, kind: str) -> str:
+    """One-line description of a media payload the relay can't render —
+    enough for the persona to name what was forwarded."""
+    m = msg.get(kind) or {}
+    if kind == "document":
+        name = m.get("file_name") or m.get("mime_type") or "file"
+        size = int(m.get("file_size") or 0)
+        return f"{name} ({size // 1024} KB)" if size else str(name)
+    if kind == "sticker":
+        return str(m.get("emoji") or m.get("set_name") or "sticker")
+    if kind in ("video", "animation"):
+        return str(m.get("file_name") or m.get("mime_type") or kind)
+    if kind == "contact":
+        return " ".join(p for p in (m.get("first_name"),
+                                    m.get("last_name")) if p) or "contact"
+    if kind in ("location", "venue"):
+        return str(m.get("title")
+                   or f"{m.get('latitude')},{m.get('longitude')}")
+    if kind == "poll":
+        return str(m.get("question") or "poll")
+    return kind
+
+
