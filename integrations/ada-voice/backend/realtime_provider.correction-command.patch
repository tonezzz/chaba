+    def _user_memory_directive(self, source_text: str) -> bool:
+        """True when the user's own recent speech carries an explicit
+        directive to store, correct, or retract a memory — 'แก้ไขด้วย',
+        'remember that', 'forget it' (OPS-0567: the order IS the
+        authorization; confirm-first stays for inferred/uncertain facts).
+        Negated forms ('อย่าจำ', 'don't record that') and questions don't
+        count; 'I/you remember X' is recollection, not an order. Only
+        consulted for memory-write calls (_memory_directed_call) — it
+        never authorizes actuation."""
+        text = (source_text or "").strip()
+        if not text or self._is_junk_turn(text):
+            return False
+        if _CONFIRM_QUESTION_RE.search(text):
+            return False
+        m = _MEMORY_DIRECTIVE_RE.search(text)
+        while m:
+            lead = text[max(0, m.start() - 40):m.start()]
+            if _MEMORY_DIRECTIVE_NEG_RE.search(lead):
+                m = _MEMORY_DIRECTIVE_RE.search(text, m.end())
+                continue
+            if (m.group(0).lower() == "remember"
+                    and _MEMORY_REMEMBER_PRONOUN_RE.search(lead)):
+                m = _MEMORY_DIRECTIVE_RE.search(text, m.end())
+                continue
+            return True
+        return False
+
