+# Explicit memory directives (OPS-0567, card
+# correction-commands-die-at-the-confirm-gate): a correction or remember
+# order in the user's own turn — 'CRV เป็นรถของกุ้ง ไม่ใช่ของผมนะ
+# แก้ไขด้วย', 'remember that', 'forget it' — IS the authorization for the
+# write; asking for a yes on top of the order is the failure that let the
+# correction die unwritten (transcript 2026-10-13-cac2984711).
+# _user_memory_directive() checks this pattern; it is consulted ONLY for
+# the memory-write seats (_memory_directed_call) and never authorizes
+# actuation, captures, or publishes.
+_MEMORY_DIRECTIVE_RE = re.compile(
+    r"\bremember\b|\bnote\s+(?:it|this|that)\b|"
+    r"\bjot\s+(?:it|this|that)(?:\s+down)?\b|"
+    r"\bwrite\s+(?:it|this|that)\s+down\b|\brecord\s+(?:it|this|that)\b|"
+    r"\bsave\s+(?:it|this|that)\b|"
+    r"\b(?:fix|correct|change|update)\s+"
+    r"(?:it|that|this|the\s+record|the\s+memory|your\s+memory)\b|"
+    r"\bforget\s+(?:it|that|this|about\s+it)\b|"
+    # STT splits Thai syllables with spaces — \s* between fragments.
+    r"จำ\s*(?:เอา\s*)?ไว้|จด\s*(?:ไว้|บันทึก)|บันทึก|เก็บ\s*ไว้|"
+    r"แก้\s*ไข|แก้\s*(?:ด้วย|ให้|หน่อย|นะ)|"
+    r"เปลี่ยน\s*(?:เป็น|ให้|ด้วย|หน่อย|นะ|บันทึก|ข้อมูล|ความ\s*จำ)|"
+    r"อัปเดต|อัพเดท|"
+    r"ลืม\s*(?:มัน|ไป|เรื่อง|เถอะ|ซะ)|ลบ\s*(?:มัน|ออก|ทิ้ง|ที่|ความจำ)|"
+    r"เอา\s*ออก",
+    re.IGNORECASE,
+)
+# Negation in front of the directive reverses it — 'อย่าจำ', 'don't
+# record that', 'ไม่ต้องแก้' are vetoes, not orders. Scanned over the
+# ~40 chars before the match (same lead-stance idea as _CONFIRM_NEG_RE).
+# Bare ไม่ is deliberately absent — the correction content itself
+# negates ('ไม่ใช่ของผมนะ แก้ไขด้วย' must still authorize).
+_MEMORY_DIRECTIVE_NEG_RE = re.compile(
+    r"\b(?:don't|do\s+not|never|no\s+need|stop)\s*$|"
+    r"อย่า|หยุด|เลิก|ไม่\s*ต้อง|ไม่\s*เอา",
+    re.IGNORECASE,
+)
+# 'I remember X' / 'do you remember X' is recollection, not a store
+# order — 'remember' only counts when no speaker/subject pronoun
+# immediately precedes it.
+_MEMORY_REMEMBER_PRONOUN_RE = re.compile(
+    r"(?:^|\s)(?:i|you|we|they|he|she)\s*$", re.IGNORECASE)
+
+
+def _memory_directed_call(name: str, args: dict) -> bool:
+    """True for the confirm-gated memory-write seats an explicit user
+    directive can authorize — ada_remember's curated-bank kinds and
+    ada_forget, plus ada_ops action='outcome' (the memory-feedback seat).
+    Callers already carved ada_remember's non-bank kinds (vocab/guest/
+    habit) out of the gated block — they were never confirm-gated."""
+    if name in ("ada_remember", "ada_forget"):
+        return True
+    return (name == "ada_ops"
+            and str((args or {}).get("action") or "").lower() == "outcome")
+
