+    async def _emit_reply(self, reply: str, started: float,
+                          degraded: bool = False) -> None:
+        """Emit one assistant reply — history append, transcript deltas,
+        response_completed. `degraded` marks the canned degraded-mode
+        notice so ops events stay distinguishable from real replies."""
+        self._turns.append({"role": "model",
+                            "parts": [{"text": reply}]})
+        if self.conversation is not None:
+            try:
+                self.conversation.add_assistant(reply)
+            except Exception:
+                pass
+        self._response_active = True
+        await self._queue.put(ProviderEvent("response_started", {}))
+        step = 48
+        for i in range(0, len(reply), step):
+            if self._closed:
+                break
+            await self._queue.put(ProviderEvent(
+                "assistant_transcript_delta", {"text": reply[i:i + step]}))
+        self._response_active = False
+        await self._queue.put(ProviderEvent("response_completed", {}))
+        self._emit_ops_event(
+            "degraded_mode_reply" if degraded else
+            ("text_mode_reply" if self.tools_enabled
+             else "or_fallback_reply"),
+            f"text reply via "
+            f"{self._text_model if self.tools_enabled else self.model} "
+            f"({time.monotonic() - started:.1f}s)"
+            + (" [degraded-mode]" if degraded else ""))
+
+    def _last_user_text(self) -> str:
+        """Most recent real user text — feeds degraded-notice language
+        detection. Context injections ride role 'system' and tool
+        payloads role 'tool', so the last 'user' turn with text is the
+        speaker's own words."""
+        for t in reversed(self._turns):
+            if t.get("role") != "user":
+                continue
+            text = "".join(p.get("text", "") for p in t.get("parts", [])
+                           if isinstance(p, dict))
+            text = text.strip()
+            if text and not text.startswith("(system"):
+                return text
+        return ""
+
