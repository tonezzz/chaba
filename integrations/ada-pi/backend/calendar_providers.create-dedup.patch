+    async def _find_duplicate(
+        self, provider: Any, calid: str | None,
+        title: str, start: datetime | date,
+    ) -> dict[str, Any] | None:
+        """Idempotent-create guard (card calendar-write-idempotency): a
+        retried or double-invoked create must not mint a second identical
+        event — 2026-10-13 a model retry wrote the same kk-ha event twice,
+        1s apart. Lists the target calendar's day window and returns the
+        existing event as {..., dedup: True, existing: <qualified id>}
+        when normalized title + start match. A failed list propagates
+        (same loud-fail rule as the reads): a blind create is exactly how
+        the double-write happened."""
+        day = start.astimezone(self.tz).date() if isinstance(start, datetime) else start
+        ws, we = day_range(day, 1, self.tz)
+        target_cal = calid or getattr(provider, "default_calendar", None)
+        want_title = _norm_title(title)
+        want_start = _dedup_start_key(start)
+        for ev in await provider.list_events(ws, we):
+            if target_cal is not None and ev.calendar != target_cal:
+                continue
+            if _norm_title(ev.title) != want_title:
+                continue
+            parsed = _event_start(ev.start, self.tz)
+            if ev.all_day and isinstance(parsed, datetime):
+                parsed = parsed.date()
+            if _dedup_start_key(parsed) != want_start:
+                continue
+            ev.id = _qualify(provider.name, ev.id)
+            out = asdict(ev)
+            out["dedup"] = True
+            out["existing"] = out["id"]
+            return out
+        return None
+
