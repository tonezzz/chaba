+def _norm_title(title: str) -> str:
+    """Dedup comparison key for titles — NFC + casefold + collapsed
+    whitespace, so '  Trip' == 'trip' and Thai combining sequences compare
+    equal across normalization forms."""
+    return " ".join(
+        unicodedata.normalize("NFC", str(title)).casefold().split())
+
+
+def _event_start(value: str, tz: ZoneInfo) -> datetime | date | None:
+    """Parse a provider-returned ISO start (RFC3339 or bare date); naive
+    datetimes get local tz. None on junk — unparseable rows can never
+    dedup-match."""
+    v = str(value or "").strip()
+    if not v:
+        return None
+    try:
+        return date.fromisoformat(v)
+    except ValueError:
+        pass
+    try:
+        dt = datetime.fromisoformat(v.replace("Z", "+00:00"))
+    except ValueError:
+        return None
+    if dt.tzinfo is None:
+        dt = dt.replace(tzinfo=tz)
+    return dt
+
+
+def _dedup_start_key(value: datetime | date | None) -> str | None:
+    """Canonical start key for dedup: dates compare by day, datetimes by
+    absolute instant ('+07:00' vs 'Z' spellings of the same instant match).
+    None for unparseable input — never equals a real key."""
+    if value is None:
+        return None
+    if not isinstance(value, datetime):
+        return f"day:{value.isoformat()}"
+    return f"at:{value.astimezone(timezone.utc).isoformat()}"
+
+
