+def _persona_instances() -> dict[str, str]:
+    """LINE_PERSONA_INSTANCE="ada:tony,kaewta:kk" -> {persona:
+    ADA_INSTANCE_ID}. The /send API is addressed by instance id while
+    turns route by persona name — this join lets 'reply in this room'
+    find the chat the lane is actually answering in. The backend's
+    'ready' hello announces the same id live and wins when it arrives;
+    the env map covers pre-connect lookups and older backends."""
+    out: dict[str, str] = {}
+    for part in os.environ.get("LINE_PERSONA_INSTANCE", "").split(","):
+        if ":" in part:
+            name, inst = part.split(":", 1)
+            name, inst = name.strip().lower(), inst.strip()
+            if name and inst:
+                out[name] = inst
+    return out
