+    def _learn_instance(self, ws_url: str, instance: str) -> None:
+        """Bind a persona's ws_url to the ADA_INSTANCE_ID its backend
+        announced in 'ready' — live self-report, wins over env config."""
+        instance = instance.strip()
+        if instance and self._ws_instance.get(ws_url) != instance:
+            logger.info("backend %s announced instance %s",
+                        ws_url, instance)
+            self._ws_instance[ws_url] = instance
+
+    def _persona_instance(self, persona: str) -> str | None:
+        """The ADA_INSTANCE_ID behind a persona name — the backend's own
+        'ready' announcement first, LINE_PERSONA_INSTANCE as the
+        configured fallback."""
+        url = _name_backends().get(persona)
+        if url and url in self._ws_instance:
+            return self._ws_instance[url]
+        return _persona_instances().get(persona)
+
+    def _note_recent(self, persona: str, chat_id: str) -> None:
+        """Record the chat a turn delivered into — the /send default when
+        a lane doesn't name a target. Keyed under the persona AND its
+        instance alias so a chat_send's instance= lookup finds it."""
+        now = time.monotonic()
+        self._recent_chat[persona] = (chat_id, now)
+        inst = self._persona_instance(persona)
+        if inst:
+            self._recent_chat[inst] = (chat_id, now)
+
