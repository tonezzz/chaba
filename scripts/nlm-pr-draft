#!/usr/bin/env python3
"""Draft a PR description from the current branch's diff using NotebookLM."""
import argparse
import re
import subprocess
import sys
from pathlib import Path

REPO = Path.home() / "CascadeProjects" / "chaba"
NOTEBOOK_ID = "fdfd3483-6b7e-4cb0-85f3-7f060698769c"


def _run(cmd):
    out = subprocess.run(cmd, text=True, capture_output=True, timeout=30)
    return out.stdout.strip() if out.returncode == 0 else out.stderr.strip()


def _commits(base="master"):
    return _run(["git", "-C", str(REPO), "log", f"{base}...HEAD", "--oneline"])


def _diff(base="master"):
    return _run(["git", "-C", str(REPO), "diff", f"{base}...HEAD"])


def main():
    parser = argparse.ArgumentParser(description="Draft a PR description from the current diff.")
    parser.add_argument("--base", default="master", help="Base branch to diff against")
    parser.add_argument("--context", "-c", default="", help="Extra context for the drafter")
    args = parser.parse_args()

    commits = _commits(args.base)
    diff = _diff(args.base)
    if not diff:
        print("No diff to describe.", file=sys.stderr)
        sys.exit(1)

    # Limit the diff to fit a notebook query (roughly 4000 tokens / ~15000 chars)
    diff = diff[:12000]

    prompt = f"""You are summarizing a git PR. Here are the commits:

{commits}

Here is the diff (truncated):

```diff
{diff}
```

{args.context}

Please draft a concise PR description with these sections:
1. Summary (2-3 bullets)
2. Key files changed and why
3. Test plan / verification checklist
4. Any risks or follow-ups

Use plain text, not markdown tables. Do not include Generated with Devin.
"""

    out = subprocess.run(
        ["nlmq", NOTEBOOK_ID, prompt, "--timeout", "120"],
        text=True, capture_output=True, timeout=180,
    )
    if out.returncode != 0:
        print(out.stderr, file=sys.stderr)
        sys.exit(out.returncode)

    # Strip notebook wrapper if any
    text = out.stdout
    text = re.sub(r"\n## Sources:.*", "", text, flags=re.DOTALL)
    print(text.strip())


if __name__ == "__main__":
    main()
