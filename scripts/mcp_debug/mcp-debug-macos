#!/usr/bin/env python3
"""mcp-debug-macos: compact, LLM-friendly output wrapper for macOS commands."""

import json
import re
import shutil
import subprocess
import sys

MAX_RAW = 10000


def _run(argv, timeout=15):
    if not shutil.which(argv[0]):
        return None, f"command not found: {argv[0]}"
    try:
        result = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
        return result, None
    except Exception as e:
        return None, str(e)


def compact_df():
    result, err = _run(["df", "-h"])
    if err:
        return {"ok": False, "error": err}
    fss = []
    for line in result.stdout.strip().splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 9:
            # macOS df -h has: Filesystem Size Used Avail Capacity iused ifree %iused Mounted on
            # Filesystem may contain a space (e.g., "map auto_home"), so parse from the right.
            fss.append({
                "m": parts[-1],
                "iu": parts[-2],
                "if": parts[-3],
                "ic": parts[-4],
                "c": parts[-5],
                "a": parts[-6],
                "u": parts[-7],
                "s": parts[-8],
                "f": " ".join(parts[:-8]),
            })
    return {"ok": True, "cmd": "df -h", "n": len(fss), "fs": fss}


def compact_ps():
    result, err = _run(["ps", "-e", "-o", "pid,pcpu,pmem,comm"])
    if err:
        return {"ok": False, "error": err}
    procs = []
    for line in result.stdout.strip().splitlines()[1:]:
        parts = line.split(None, 3)
        if not parts:
            continue
        procs.append({
            "p": parts[0],
            "u": parts[1] if len(parts) > 1 else "",
            "m": parts[2] if len(parts) > 2 else "",
            "c": parts[3] if len(parts) > 3 else "",
        })
    procs.sort(key=lambda x: float(x["u"] or 0), reverse=True)
    return {"ok": True, "cmd": "ps", "n": min(20, len(procs)), "p": procs[:20]}


def compact_ps_top(args):
    # args come from ps invocation: e.g. ['-eo', 'pid,ppid,cmd,%cpu', '--sort=-%cpu']
    # Map Linux syntax to macOS ps.
    sort_metric = "cpu"
    if any("%mem" in a for a in args):
        sort_metric = "mem"
    result, err = _run(["ps", "-e", "-o", "pid,ppid,pcpu,pmem,command", "-r" if sort_metric == "cpu" else "-m"])
    if err:
        return {"ok": False, "error": err}
    procs = []
    for line in result.stdout.strip().splitlines()[1:21]:
        parts = line.split(None, 4)
        if len(parts) < 5:
            continue
        procs.append({
            "p": parts[0],
            "pp": parts[1],
            "u": parts[2],
            "m": parts[3],
            "c": parts[4],
        })
    return {"ok": True, "cmd": " ".join(["ps"] + args), "n": len(procs), "p": procs}


def compact_uptime():
    result, err = _run(["uptime"])
    if err:
        return {"ok": False, "error": err}
    text = result.stdout.strip()
    up = ""
    users = ""
    m = re.search(r"up\s+(.+?),\s+(\d+)\s+user", text)
    if m:
        up = m.group(1)
        users = m.group(2)
    else:
        m = re.search(r"(\d+)\s+user", text)
        if m:
            users = m.group(1)
    load = re.findall(r"load\s+average[s]?:\s*([\d.]+)", text)
    return {"ok": True, "cmd": "uptime", "up": up, "u": users, "l": load}


def compact_mount():
    result, err = _run(["mount"])
    if err:
        return {"ok": False, "error": err}
    mounts = []
    for line in result.stdout.strip().splitlines():
        m = re.match(r"^(\S+)\s+on\s+(\S+)\s+\((.+)\)$", line)
        if m:
            mounts.append({
                "d": m.group(1),
                "p": m.group(2),
                "o": m.group(3),
            })
    return {"ok": True, "cmd": "mount", "n": len(mounts), "m": mounts}


def compact_tailscale_status():
    result, err = _run(["tailscale", "status"])
    if err:
        return {"ok": False, "error": err}
    peers = []
    for line in result.stdout.strip().splitlines():
        parts = line.split(None, 2)
        if not parts:
            continue
        peers.append({
            "ip": parts[0],
            "n": parts[1] if len(parts) > 1 else "",
            "s": parts[2] if len(parts) > 2 else "",
        })
    return {"ok": True, "cmd": "tailscale status", "n": len(peers), "p": peers}


def raw_fallback(args):
    if not args:
        return {"ok": False, "error": "no command"}
    if not shutil.which(args[0]):
        return {"ok": False, "error": f"command not found: {args[0]}"}
    result, err = _run(args, timeout=15)
    if err:
        return {"ok": False, "error": err}
    text = result.stdout
    if len(text) > MAX_RAW:
        text = text[:MAX_RAW] + f"\n...truncated ({len(result.stdout)} chars total)"
    return {
        "ok": result.returncode == 0,
        "cmd": " ".join(args),
        "rc": result.returncode,
        "out": text,
        "err": result.stderr[:1000] if result.stderr else "",
    }


def run(args):
    if not args:
        return {"ok": False, "error": "usage: mcp-debug <command> [args...]"}

    base = args[0]

    if base == "df" and (len(args) == 1 or "-h" in args):
        return compact_df()
    if base == "ps" and "-eo" in args:
        return compact_ps_top(args)
    if base == "uptime":
        return compact_uptime()
    if base == "mount":
        return compact_mount()
    if base == "tailscale" and "status" in args:
        return compact_tailscale_status()
    if base in ("systemctl", "free", "lsblk", "lsusb", "ip", "ss", "podman", "journalctl"):
        return {"ok": False, "error": f"{base} is not supported on macOS"}

    return raw_fallback(args)


if __name__ == "__main__":
    out = run(sys.argv[1:])
    print(json.dumps(out, default=str, separators=(",", ":")))
    sys.exit(0 if out.get("ok") else 1)
