#!/usr/bin/env python3
"""mcp-debug-macos: compact, LLM-friendly output wrapper for macOS commands."""

import json
import re
import shutil
import subprocess
import sys

MAX_RAW = 10000


def _run(argv, timeout=15):
    if not shutil.which(argv[0]):
        return None, f"command not found: {argv[0]}"
    try:
        result = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
        return result, None
    except Exception as e:
        return None, str(e)


def compact_df():
    result, err = _run(["df", "-h"])
    if err:
        return {"ok": False, "error": err}
    fss = []
    for line in result.stdout.strip().splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 9:
            # macOS df -h has: Filesystem Size Used Avail Capacity iused ifree %iused Mounted on
            # Filesystem may contain a space (e.g., "map auto_home"), so parse from the right.
            fss.append({
                "m": parts[-1],
                "iu": parts[-2],
                "if": parts[-3],
                "ic": parts[-4],
                "c": parts[-5],
                "a": parts[-6],
                "u": parts[-7],
                "s": parts[-8],
                "f": " ".join(parts[:-8]),
            })
    return {"ok": True, "cmd": "df -h", "n": len(fss), "fs": fss}


def compact_ps():
    result, err = _run(["ps", "-e", "-o", "pid,pcpu,pmem,comm"])
    if err:
        return {"ok": False, "error": err}
    procs = []
    for line in result.stdout.strip().splitlines()[1:]:
        parts = line.split(None, 3)
        if not parts:
            continue
        procs.append({
            "p": parts[0],
            "u": parts[1] if len(parts) > 1 else "",
            "m": parts[2] if len(parts) > 2 else "",
            "c": parts[3] if len(parts) > 3 else "",
        })
    procs.sort(key=lambda x: float(x["u"] or 0), reverse=True)
    return {"ok": True, "cmd": "ps", "n": min(20, len(procs)), "p": procs[:20]}


def compact_ps_top(args):
    # args come from ps invocation: e.g. ['-eo', 'pid,ppid,cmd,%cpu', '--sort=-%cpu']
    # Map Linux syntax to macOS ps.
    sort_metric = "cpu"
    if any("%mem" in a for a in args):
        sort_metric = "mem"
    result, err = _run(["ps", "-e", "-o", "pid,ppid,pcpu,pmem,command", "-r" if sort_metric == "cpu" else "-m"])
    if err:
        return {"ok": False, "error": err}
    procs = []
    for line in result.stdout.strip().splitlines()[1:21]:
        parts = line.split(None, 4)
        if len(parts) < 5:
            continue
        procs.append({
            "p": parts[0],
            "pp": parts[1],
            "u": parts[2],
            "m": parts[3],
            "c": parts[4],
        })
    return {"ok": True, "cmd": " ".join(["ps"] + args), "n": len(procs), "p": procs}


def compact_uptime():
    result, err = _run(["uptime"])
    if err:
        return {"ok": False, "error": err}
    text = result.stdout.strip()
    up = ""
    users = ""
    m = re.search(r"up\s+(.+?),\s+(\d+)\s+user", text)
    if m:
        up = m.group(1)
        users = m.group(2)
    else:
        m = re.search(r"(\d+)\s+user", text)
        if m:
            users = m.group(1)
    load = re.findall(r"load\s+average[s]?:\s*([\d.]+)", text)
    return {"ok": True, "cmd": "uptime", "up": up, "u": users, "l": load}


def compact_mount():
    result, err = _run(["mount"])
    if err:
        return {"ok": False, "error": err}
    mounts = []
    for line in result.stdout.strip().splitlines():
        m = re.match(r"^(\S+)\s+on\s+(\S+)\s+\((.+)\)$", line)
        if m:
            mounts.append({
                "d": m.group(1),
                "p": m.group(2),
                "o": m.group(3),
            })
    return {"ok": True, "cmd": "mount", "n": len(mounts), "m": mounts}


def compact_tailscale_status():
    result, err = _run(["tailscale", "status"])
    if err:
        return {"ok": False, "error": err}
    peers = []
    for line in result.stdout.strip().splitlines():
        parts = line.split(None, 2)
        if not parts:
            continue
        peers.append({
            "ip": parts[0],
            "n": parts[1] if len(parts) > 1 else "",
            "s": parts[2] if len(parts) > 2 else "",
        })
    return {"ok": True, "cmd": "tailscale status", "n": len(peers), "p": peers}


def compact_top(args):
    # args includes the 'top' base; use the rest as flags
    result, err = _run(["top"] + args[1:])
    if err:
        return {"ok": False, "error": err}
    procs = []
    for line in result.stdout.splitlines():
        # PID  COMMAND ... %CPU  TIME(mm:ss.cc) ...
        m = re.match(r"^(\d+)\s+(.+?)\s+(\d+\.\d+)\s+\d+:\d+\.\d+", line)
        if not m:
            continue
        procs.append({
            "p": m.group(1),
            "c": m.group(2).strip(),
            "u": m.group(3),
        })
    # top -l 1 -n 10 already limits output; trim to first 10 data rows
    return {"ok": True, "cmd": " ".join(args), "n": min(10, len(procs)), "p": procs[:10]}


def compact_lsof(args):
    # args includes the 'lsof' base; use the rest as flags
    result, err = _run(["lsof"] + args[1:])
    if err:
        return {"ok": False, "error": err}
    rows = []
    for line in result.stdout.strip().splitlines()[1:]:
        parts = line.split(None, 8)
        if len(parts) < 9:
            continue
        rows.append({
            "c": parts[0],
            "p": parts[1],
            "u": parts[2],
            "t": parts[4],
            "n": parts[8],
        })
    return {"ok": True, "cmd": " ".join(args), "n": len(rows), "r": rows}


def compact_launchctl_list():
    result, err = _run(["launchctl", "list"])
    if err:
        return {"ok": False, "error": err}
    services = []
    for line in result.stdout.strip().splitlines()[1:]:
        parts = line.split(None, 2)
        if not parts:
            continue
        services.append({
            "p": parts[0],
            "l": parts[2] if len(parts) > 2 else "",
        })
    # Keep a representative sample to keep compact output much smaller than raw.
    services = services[:50]
    return {"ok": True, "cmd": "launchctl list", "n": len(services), "s": services}


def raw_fallback(args):
    if not args:
        return {"ok": False, "error": "no command"}
    if not shutil.which(args[0]):
        return {"ok": False, "error": f"command not found: {args[0]}"}
    result, err = _run(args, timeout=15)
    if err:
        return {"ok": False, "error": err}
    text = result.stdout
    if len(text) > MAX_RAW:
        text = text[:MAX_RAW] + f"\n...truncated ({len(result.stdout)} chars total)"
    return {
        "ok": result.returncode == 0,
        "cmd": " ".join(args),
        "rc": result.returncode,
        "out": text,
        "err": result.stderr[:1000] if result.stderr else "",
    }


def compact_containers():
    for engine in ("podman", "docker"):
        if not shutil.which(engine):
            continue
        result, err = _run([engine, "ps", "--format", "json"])
        if err:
            continue
        try:
            data = json.loads(result.stdout)
        except Exception:
            continue
        if not isinstance(data, list):
            continue
        def _port_str(p):
            if isinstance(p, dict):
                host = p.get("host_port") or ""
                cont = p.get("container_port") or ""
                proto = p.get("protocol") or ""
                if host:
                    return f"{host}:{cont}/{proto}" if cont and proto else f"{host}:{cont}" if cont else str(p)
                return f"{cont}/{proto}" if cont and proto else str(p)
            return str(p)

        containers = []
        for c in data:
            names = c.get("Names") or c.get("names") or c.get("name") or ""
            if isinstance(names, list):
                names = names[0] if names else ""
            ports = c.get("Ports") or c.get("ports") or ""
            if isinstance(ports, list):
                ports = ",".join(_port_str(p) for p in ports)
            elif isinstance(ports, dict):
                ports = _port_str(ports)
            image = c.get("Image") or c.get("image") or ""
            if isinstance(image, list):
                image = image[0] if image else ""
            containers.append({
                "n": names,
                "i": image,
                "s": c.get("Status") or c.get("status") or c.get("State") or "",
                "p": ports,
            })
        return {"ok": True, "cmd": "containers", "runtime": engine, "n": len(containers), "c": containers}
    return {"ok": False, "error": "no container engine found"}


def compact_services():
    out = compact_launchctl_list()
    if not out.get("ok"):
        return out
    out["cmd"] = "services"
    out["runtime"] = "launchctl"
    return out


def _port_only(s):
    if not s:
        return s
    if ":" in s:
        return s.rsplit(":", 1)[-1]
    if "." in s and s.count(".") >= 4:
        return s.rsplit(".", 1)[-1]
    return s


def compact_sockets():
    """sockets -> compact listening TCP sockets from lsof or netstat."""
    tried = []

    if shutil.which("lsof"):
        result, err = _run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN"])
        if err:
            tried.append(f"lsof: {err}")
        elif result.returncode == 0:
            sockets = []
            for line in result.stdout.strip().splitlines()[1:]:
                parts = line.split(None, 8)
                if len(parts) < 9:
                    continue
                sockets.append({
                    "c": parts[0],
                    "p": parts[1],
                    "l": parts[8],
                    "n": parts[8],
                })
            return {"ok": True, "cmd": "sockets", "runtime": "lsof", "n": len(sockets), "s": sockets}
        else:
            tried.append(f"lsof: {result.stderr.strip() or 'no listening sockets'}")

    if shutil.which("netstat"):
        result, err = _run(["netstat", "-an"])
        if err:
            tried.append(f"netstat: {err}")
        elif result.returncode == 0:
            sockets = []
            for line in result.stdout.strip().splitlines():
                parts = line.split()
                if not parts or "LISTEN" not in parts:
                    continue
                if len(parts) >= 5:
                    local = parts[3]
                    sockets.append({
                        "l": local,
                        "p": _port_only(local),
                        "n": "",
                    })
            return {"ok": True, "cmd": "sockets", "runtime": "netstat", "n": len(sockets), "s": sockets}
        else:
            tried.append(f"netstat: {result.stderr.strip() or 'no listening sockets'}")

    return {"ok": False, "error": "; ".join(tried) if tried else "no socket tool found"}


def compact_gpu():
    return {"ok": False, "error": "no GPU tool available on macOS"}


def run(args):
    if not args:
        return {"ok": False, "error": "usage: mcp-debug <command> [args...]"}

    base = args[0]

    if base == "df" and (len(args) == 1 or "-h" in args):
        return compact_df()
    if base == "ps" and "-eo" in args:
        return compact_ps_top(args)
    if base == "uptime":
        return compact_uptime()
    if base == "mount":
        return compact_mount()
    if base == "tailscale" and "status" in args:
        return compact_tailscale_status()
    if base == "top" and ("-l" in args and "-n" in args):
        return compact_top(args)
    if base == "lsof" and ("-nP" in args or "-i" in args):
        return compact_lsof(args)
    if base == "launchctl" and "list" in args:
        return compact_launchctl_list()
    if base == "containers":
        return compact_containers()
    if base == "services":
        return compact_services()
    if base == "sockets":
        return compact_sockets()
    if base == "gpu":
        return compact_gpu()
    if base in ("systemctl", "free", "lsblk", "lsusb", "ip", "ss", "journalctl"):
        return {"ok": False, "error": f"{base} is not supported on macOS"}

    return raw_fallback(args)


if __name__ == "__main__":
    out = run(sys.argv[1:])
    print(json.dumps(out, default=str, separators=(",", ":")))
    sys.exit(0 if out.get("ok") else 1)
