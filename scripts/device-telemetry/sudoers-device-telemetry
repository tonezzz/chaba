# device-telemetry agent — Apple Silicon thermal pressure probe.
# Replace `tony` with the local account name before installing.
# Install: sudo install -m 440 scripts/device-telemetry/sudoers-device-telemetry /etc/sudoers.d/device-telemetry
# then: sudo visudo -cf /etc/sudoers.d/device-telemetry
tony ALL=(root) NOPASSWD: /usr/bin/powermetrics
