---
# Generated by ansible/playbooks/ada-ocb-audit.yml — read-only snapshot.
generated: "{{ lookup('pipe', 'date -u +%Y-%m-%dT%H:%M:%SZ') }}"
host: "{{ target }}"
role: "{{ hostvars[target].ocb_role | default('unknown') }}"
{% set probe = hostvars[target].ocb_probe %}
producer:
  node: "{{ probe.node_version }}"
  web: "{{ probe.web_version }}"
  cli: "{{ probe.cli_version }}"
  units:
{% for unit, state in probe.units.items() %}
    "{{ unit }}": "{{ state }}"
{% endfor %}
  update_timer_next: "{{ probe.update_timer_next }}"
  bind_3000: "{{ probe.bind_3000 }}"
  local_http: "{{ probe.local_http }}"
  patch_present: {{ probe.patch_present | to_json }}
  startup_env_mode: "{{ probe.startup_env_mode }}"
  litellm_dropin: {{ probe.litellm_dropin | to_json }}
consumer:
  edge_url: "{{ ocb_edge_url }}"
  edge_http: "{{ ocb_edge.http }}"
  edge_csp: "{{ ocb_edge.csp }}"
  csp_frame_ancestors: {{ (ocb_edge_csp_must_contain in ocb_edge.csp) | to_json }}
