{# disk-headroom.j2 — per-host mount verdicts.
   States: crit (any real mount >= crit_pct, disk-trend's flat rule),
   warn (/ >= ssot max_root_disk_percent or / free < min_free_gib), ok.
   Rows also carry `underused` (mount < underused_pct used or
   > underused_free_gib free on a >= underused_min_size_gib
   filesystem, only when the mount would otherwise be ok) —
   informational capacity signal.
   Context: target, hostvars, audit_ssot, ssot_key_map, crit_pct,
   min_free_gib, underused_pct, underused_free_gib,
   underused_min_size_gib. #}
{%- set hk = ssot_key_map.get(target, target) -%}
{%- set hs = (audit_ssot['hosts'] | default({})).get(hk) or {} -%}
{%- set res = hs.get('expected_resources') or {} -%}
{%- set root_max = (res.get('max_root_disk_percent') or 90) | int -%}
{%- set ns = namespace(rows=[], unreachable=false) -%}
{%- if hostvars[target].mounts is defined -%}
{%-   for m in hostvars[target].mounts -%}
{%-     set st = 'ok' -%}
{%-     set why = [] -%}
{%-     if m.pct | int >= crit_pct | int -%}
{%-       set st = 'crit' -%}
{%-       set _ = why.append('pct ' ~ m.pct ~ ' >= crit ' ~ crit_pct) -%}
{%-     endif -%}
{%-     if m.mount == '/' and m.pct | int >= root_max and st == 'ok' -%}
{%-       set st = 'warn' -%}
{%-       set _ = why.append('/ pct ' ~ m.pct ~ ' >= ssot max_root_disk_percent ' ~ root_max) -%}
{%-     endif -%}
{%-     if m.mount == '/' and (m.avail_kb | int) < min_free_gib * 1048576 -%}
{%-       set st = 'crit' if st == 'crit' else 'warn' -%}
{%-       set _ = why.append('/ avail ' ~ ((m.avail_kb | int) / 1048576) | round(1) ~ ' GiB < ' ~ min_free_gib ~ ' GiB guard floor') -%}
{%-     endif -%}
{%-     set under = (st == 'ok')
          and ((m.size_kb | int) >= underused_min_size_gib * 1048576)
          and ((m.pct | int < underused_pct | int)
          or ((m.avail_kb | int) > underused_free_gib * 1048576)) -%}
{%-     set _ = ns.rows.append({'mount': m.mount, 'fs': m.fs,
        'size_gib': ((m.size_kb | int) / 1048576) | round(1),
        'avail_gib': ((m.avail_kb | int) / 1048576) | round(1),
        'pct': m.pct, 'state': st, 'why': why | join('; '),
        'underused': under}) -%}
{%-   endfor -%}
{%- else -%}
{%-   set ns.unreachable = true -%}
{%- endif -%}
{%- set worst = ns.rows | selectattr('state', 'eq', 'crit') | list -%}
{%- set warns = ns.rows | selectattr('state', 'eq', 'warn') | list -%}
{%- set under = ns.rows | selectattr('underused') | list -%}
{%- set under_txt = ('; underused: '
        ~ (under | map(attribute='mount') | join(', '))) if under else '' -%}
{%- if ns.unreachable -%}
{%-   set summary_text = 'unreachable ('
        ~ ('offline_ok' if hs.get('offline_ok') else 'NOT offline_ok') ~ ')' -%}
{%- elif worst -%}
{%-   set summary_text = 'CRIT: ' ~ (worst | map(attribute='mount') | join(', '))
        ~ ('; warn: ' ~ (warns | map(attribute='mount') | join(', ')) if warns else '')
        ~ under_txt -%}
{%- elif warns -%}
{%-   set summary_text = 'warn: ' ~ (warns | map(attribute='mount') | join(', '))
        ~ under_txt -%}
{%- elif under -%}
{%-   set summary_text = 'underused: ' ~ (under | map(attribute='mount') | join(', '))
        ~ ' (' ~ (ns.rows | length) ~ ' mounts)' -%}
{%- else -%}
{%-   set summary_text = 'ok (' ~ (ns.rows | length) ~ ' mounts)' -%}
{%- endif -%}
host: {{ hk }}
inventory_host: {{ target }}
unreachable: {{ ns.unreachable }}
ssot_max_root_disk_percent: {{ root_max }}
summary: {{ summary_text | to_json }}
underused_mounts: {{ ns.rows | selectattr('underused') | map(attribute='mount') | list | to_json }}
mounts:
{{ ns.rows | to_nice_yaml | indent(2, true) }}