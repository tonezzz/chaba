{
  "ignorePatterns": [
    {
      "pattern": "^http://localhost",
      "comment": "Ignore localhost links"
    },
    {
      "pattern": "^http://192\\.168\\.",
      "comment": "Ignore local network IP links"
    },
    {
      "pattern": "^http://tony-",
      "comment": "Ignore local hostname links"
    },
    {
      "pattern": "^https?://.*\\.local",
      "comment": "Ignore .local hostname links"
    }
  ],
