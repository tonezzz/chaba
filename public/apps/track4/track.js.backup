const ROUND_DIST = 25;
const DEFAULT_COURSE = 'tabsai-ws8-track3';
let courseId = new URLSearchParams(window.location.search).get('course') || DEFAULT_COURSE;
let saveTimer = null;
let courseData = null;
let renderer = null;
let state = { overrides: {}, hidden: new Set() };

const map = L.map('map');

const raceLayer = L.layerGroup().addTo(map);
const boatColors = ['#ef4444','#22c55e','#3b82f6','#f59e0b','#a855f7','#ec4899','#06b6d4','#eab308','#6366f1','#14b8a6'];

// Initialize MapLayerManager if available
let mapLayerManager = null;
let baseLayers = {};
let overlayLayers = {};
let layerControl = null;

if (typeof MapLayerManager !== 'undefined') {
  try {
    mapLayerManager = new MapLayerManager(map);
    
    // Add base layers
    mapLayerManager.addBaseLayer('Dark (CARTO)', L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd', maxZoom: 19
    }), false);
    
    mapLayerManager.addBaseLayer('Satellite (Esri)', L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
      attribution: 'Tiles &copy; Esri',
      maxZoom: 19
    }), true); // Default
    
    mapLayerManager.addBaseLayer('Standard (OSM)', L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a>',
      maxZoom: 19
    }), false);
    
    mapLayerManager.addBaseLayer('Terrain (CARTO)', L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd', maxZoom: 19
    }), false);
    
    // Add overlay layers
    mapLayerManager.addOverlay('Race Course', raceLayer, true);
    mapLayerManager.addOverlay('Grid', L.layerGroup(), false);
    mapLayerManager.addOverlay('Distance Markers', L.layerGroup(), false);
    
    // Create layer control
    layerControl = mapLayerManager.createLayerControl({ position: 'topright' });
    
    // Expose for backward compatibility
    baseLayers = mapLayerManager.getBaseLayerIds().reduce((acc, id) => {
      acc[id] = mapLayerManager.getLayer(id);
      return acc;
    }, {});
    
    overlayLayers = mapLayerManager.getOverlayIds().reduce((acc, id) => {
      acc[id] = mapLayerManager.getLayer(id);
      return acc;
    }, {});
    
  } catch (e) {
    console.error('MapLayerManager initialization failed:', e);
    console.warn('Falling back to old layer management');
  }
}

// Fallback to old layer management if MapLayerManager not available
if (!mapLayerManager) {
  baseLayers = {
    'Dark (CARTO)': L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd', maxZoom: 19
    }),
    'Satellite (Esri)': L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
      attribution: 'Tiles &copy; Esri',
      maxZoom: 19
    }),
    'Standard (OSM)': L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a>',
      maxZoom: 19
    }),
    'Terrain (CARTO)': L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd', maxZoom: 19
    })
  };
  
  overlayLayers = {
    'Race Course': raceLayer,
    'Grid': L.layerGroup(),
    'Distance Markers': L.layerGroup()
  };
  
  baseLayers['Satellite (Esri)'].addTo(map);
  layerControl = L.control.layers(baseLayers, overlayLayers, { position: 'topright' }).addTo(map);
}

// Create grid overlay
function createGridOverlay() {
  const gridLayer = overlayLayers['Grid'];
  gridLayer.clearLayers();
  const gridSpacing = 0.001; // ~100m at this latitude
  const bounds = map.getBounds();
  
  for (let lat = Math.floor(bounds.getSouth() / gridSpacing) * gridSpacing; lat <= bounds.getNorth(); lat += gridSpacing) {
    L.polyline([[lat, bounds.getWest()], [lat, bounds.getEast()]], {
      color: '#ffffff',
      weight: 0.5,
      opacity: 0.1,
      interactive: false
    }).addTo(gridLayer);
  }
  
  for (let lng = Math.floor(bounds.getWest() / gridSpacing) * gridSpacing; lng <= bounds.getEast(); lng += gridSpacing) {
    L.polyline([[bounds.getSouth(), lng], [bounds.getNorth(), lng]], {
      color: '#ffffff',
      weight: 0.5,
      opacity: 0.1,
      interactive: false
    }).addTo(gridLayer);
  }
}

// Create distance markers overlay
function createDistanceMarkers() {
  const markerLayer = overlayLayers['Distance Markers'];
  markerLayer.clearLayers();
  const center = map.getCenter();
  const distances = [0.1, 0.5, 1, 2, 5]; // km
  
  distances.forEach(dist => {
    const circle = L.circle(center, {
      radius: dist * 1000,
      color: '#facc15',
      weight: 1,
      opacity: 0.3,
      fill: false,
      interactive: false
    }).addTo(markerLayer);
    
    // Add label
    const label = L.marker(center, {
      icon: L.divIcon({
        className: 'distance-label',
        html: `<div style="color: #facc15; font-size: 10px; background: rgba(0,0,0,0.7); padding: 2px 4px; border-radius: 3px;">${dist}km</div>`,
        iconSize: [40, 20],
        iconAnchor: [20, 10]
      }),
      interactive: false
    }).addTo(markerLayer);
  });
}

// Update overlays on map move
map.on('moveend', () => {
  if (map.hasLayer(overlayLayers['Grid'])) {
    createGridOverlay();
  }
  if (map.hasLayer(overlayLayers['Distance Markers'])) {
    createDistanceMarkers();
  }
});

// Initialize overlays when enabled
map.on('layeradd', (e) => {
  if (e.layer === overlayLayers['Grid']) {
    createGridOverlay();
  }
  if (e.layer === overlayLayers['Distance Markers']) {
    createDistanceMarkers();
  }
});

// Map dim slider
const mapDimSlider = document.getElementById('map-dim-slider');
if (mapDimSlider) {
  mapDimSlider.addEventListener('input', (e) => {
    const dimValue = e.target.value;
    const mapContainer = document.getElementById('map');
    if (mapContainer) {
      mapContainer.style.filter = `brightness(${100 - dimValue}%)`;
    }
  });
}

