#!/usr/bin/env bash
# Pre-commit hook: syntax-check staged JS/MJS and Python files, and check for hardcoded IPs.
# Set via: git config core.hooksPath /home/tony/CascadeProjects/chaba/.githooks

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

failed=0

# Syntax check JS/MJS and Python files
while IFS= read -r -d '' file; do
    case "$file" in
        *.js|*.mjs)
            if [ -f "$file" ]; then
                echo "node --check $file" >&2
                if ! node --check "$file"; then
                    failed=1
                fi
            fi
            ;;
        *.py)
            if [ -f "$file" ]; then
                echo "python3 -m py_compile $file" >&2
                if ! python3 -m py_compile "$file"; then
                    failed=1
                fi
            fi
            ;;
    esac
done < <(git diff --cached --name-only -z --diff-filter=ACM)

# Check for hardcoded IP addresses
echo "Checking for hardcoded IP addresses..."
staged_files=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$staged_files" ]; then
    # Skip documentation files and scripts that legitimately reference IPs
    skip_files=$(echo "$staged_files" | grep -E '\.(md|MD)$|pre-commit$|\.windsurfrules$|hostname-enforcement|fetch-data/|\.json$' || true)
    check_files=$(echo "$staged_files" | grep -v -E '\.(md|MD)$|pre-commit$|\.windsurfrules$|hostname-enforcement|fetch-data/|\.json$' || true)
    
    if [ -n "$check_files" ]; then
        violations=$(echo "$check_files" | xargs grep -l "192\.168\.1\.48\|192\.168\.1\.42" 2>/dev/null || true)
        if [ -n "$violations" ]; then
            echo "❌ ERROR: Found hardcoded IP addresses in staged files:"
            echo "$violations" | while read file; do
                echo "  - $file"
                echo "    Lines with IPs:"
                grep -n "192\.168\.1\.48\|192\.168\.1\.42" "$file" 2>/dev/null | sed 's/^/      /' || true
            done
            echo ""
            echo "Please use hostnames instead:"
            echo "  - Replace 192.168.1.48 with tony-omen.local"
            echo "  - Replace 192.168.1.42 with tony-dell.local"
            echo ""
            echo "Exceptions: Network documentation where IPs are explicitly relevant"
            echo "To bypass this check, use: git commit --no-verify"
            failed=1
        else
            echo "✅ No hardcoded IP addresses found in staged files"
        fi
    else
        echo "✅ Skipping IP check (documentation/policy files only)"
    fi
fi

exit "$failed"
