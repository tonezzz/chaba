#!/usr/bin/env bash
# Pre-commit hook: syntax-check staged JS/MJS and Python files.
# Set via: git config core.hooksPath /home/tony/CascadeProjects/chaba/.githooks

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

failed=0
while IFS= read -r -d '' file; do
    case "$file" in
        *.js|*.mjs)
            if [ -f "$file" ]; then
                echo "node --check $file" >&2
                if ! node --check "$file"; then
                    failed=1
                fi
            fi
            ;;
        *.py)
            if [ -f "$file" ]; then
                echo "python3 -m py_compile $file" >&2
                if ! python3 -m py_compile "$file"; then
                    failed=1
                fi
            fi
            ;;
    esac
done < <(git diff --cached --name-only -z --diff-filter=ACM)

exit "$failed"
