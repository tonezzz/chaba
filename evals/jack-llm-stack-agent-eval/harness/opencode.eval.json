{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm-eval": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM eval (house bench)",
      "options": {
        "baseURL": "http://100.102.134.91:4000/v1",
        "apiKey": "{env:LITELLM_KEY_EVAL}",
        "timeout": 300000
      },
      "models": {
        "bench": { "name": "bench (qwen2.5:32b kk-mac, $0 local)" },
        "chat-local": { "name": "chat-local (qwen2.5:7b tony-dell, $0 local)" }
      }
    }
  },
  "model": "litellm-eval/bench",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "share": "disabled",
  "autoupdate": false
}
