{"type":"tool_use","timestamp":1795516585286,"sessionID":"ses_df2e183dfffeuLS2tF4tdwn4vs","part":{"type":"tool","tool":"write","callID":"call_16462223481376013839__thought__","state":{"status":"completed","input":{"content":"#!/usr/bin/env bash\nset -euo pipefail\n\nOLLAMA_HOST=\"${OLLAMA_HOST:-http://127.0.0.1:11434}\"\nLITELLM_HOST=\"${LITELLM_HOST:-http://127.0.0.1:4000}\"\nLITELLM_KEY=\"${LITELLM_MASTER_KEY:-sk-placeholder-litellm-master-key}\"\n\necho \"[*] Checking Ollama reachability and model...\"\nOLLAMA_TAGS_RESPONSE=$(curl -sSf \"${OLLAMA_HOST}/api/tags\")\necho \"Ollama tags response: ${OLLAMA_TAGS_RESPONSE}\"\n\nif ! echo \"${OLLAMA_TAGS_RESPONSE}\" | grep -q \"qwen2.5:1.5b-instruct-q4_K_M\"; then\n    echo \"[!] Error: Ollama model qwen2.5:1.5b-instruct-q4_K_M not found in tags.\"\n    exit 1\nfi\necho \"[+] Ollama is healthy and model is present.\"\n\necho \"[*] Checking LiteLLM liveness...\"\nLITELLM_HEALTH=$(curl -sSf \"${LITELLM_HOST}/health/liveness\")\necho \"LiteLLM liveness response: ${LITELLM_HEALTH}\"\n\necho \"[*] Performing LiteLLM chat completion round-trip...\"\nCOMPLETION_RESPONSE=$(curl -sSf -X POST \"${LITELLM_HOST}/v1/chat/completions\" \\\n    -H \"Content-Type: application/json\" \\\n    -H \"Authorization: Bearer ${LITELLM_KEY}\" \\\n    -d '{\n        \"model\": \"jack-local-coder\",\n        \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}]\n    }')\necho \"Completion response: ${COMPLETION_RESPONSE}\"\n\nif ! echo \"${COMPLETION_RESPONSE}\" | grep -q \"jack-local-coder\"; then\n    echo \"[!] Error: LiteLLM chat completion did not return expected model name.\"\n    exit 1\nfi\necho \"[+] LiteLLM chat completion round-trip successful.\"\n\necho \"[*] Verifying OpenCode provider configuration...\"\nif [ ! -f \"opencode.json\" ]; then\n    echo \"[!] Error: opencode.json not found.\"\n    exit 1\nfi\npython3 -c '\nimport json\nwith open(\"opencode.json\") as f:\n    data = json.load(f)\nassert \"provider\" in data\nassert \"jack-local\" in data[\"provider\"]\nassert data[\"provider\"][\"jack-local\"][\"options\"][\"baseURL\"] == \"http://127.0.0.1:4000/v1\"\nprint(\"[+] OpenCode configuration parsed successfully and validated.\")\n'\n\necho \"[+] All health checks passed successfully!\"\n","filePath":"/home/tony/CascadeProjects/dispatch-wt-20261124-170743-compare-opencode-and-cline-on-/evals/jack-llm-stack-agent-eval/arms/opencode/healthcheck.sh"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/tony/CascadeProjects/dispatch-wt-20261124-170743-compare-opencode-and-cline-on-/evals/jack-llm-stack-agent-eval/arms/opencode/healthcheck.sh","exists":false,"truncated":false},"title":"healthcheck.sh","time":{"start":1795516585277,"end":1795516585282}},"id":"prt_20d20d5390019eDlGPm978qqd8","sessionID":"ses_df2e183dfffeuLS2tF4tdwn4vs","messageID":"msg_20d20bc13001zMBA4hYM40tbtT"}}
