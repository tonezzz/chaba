# Disposable Jack LLM stack — environment template.
# Copy to .env and fill values. NEVER commit real secrets.

# Ollama endpoint (local container or host install)
JACK_OLLAMA_URL=http://127.0.0.1:11434
# Model pulled into Ollama — must match litellm/config.yaml + RUNBOOK.md
JACK_OLLAMA_MODEL=qwen2.5:3b

# LiteLLM gateway endpoint (OpenAI-compatible)
JACK_LITELLM_URL=http://127.0.0.1:4000
# LiteLLM virtual/master key — PLACEHOLDER, mint a real one per deploy
JACK_LITELLM_API_KEY=CHANGE_ME_LITELLM_KEY
# Master key used by litellm itself — PLACEHOLDER
LITELLM_MASTER_KEY=CHANGE_ME_LITELLM_MASTER_KEY

# Bind address — loopback only for the disposable deployment
JACK_BIND_ADDR=127.0.0.1
