{
  "name": "chaba.h3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c ./tailwind.config.cjs -i ./src/tailwind.css -o ./public/assets/tailwind.css",
    "watch:css": "tailwindcss -c ./tailwind.config.cjs -i ./src/tailwind.css -o ./public/assets/tailwind.css --watch",
    "sync:docs": "node scripts/sync-docs-overview.mjs",
    "serve:php": "php -S 0.0.0.0:8123 -t public",
    "serve:php:quiet": "php -S 0.0.0.0:8123 -t public > /tmp/chaba-php.log 2>&1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "tailwindcss": "^3.4.19"
  }
}
