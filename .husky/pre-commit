#!/bin/bash
# SSOT Pre-commit Validation Hook
# Validates SSOT YAML files before commit

set -e

# Privacy guard: personal vault notes must never be committed — chaba is
# public on GitHub. .gitignore covers normal adds; this catches -f force-adds
# and gitignore regressions.
if git diff --cached --name-only | grep -q '^docs/ada-memory/personal/'; then
    echo "❌ BLOCKED: docs/ada-memory/personal/** is staged — this repo is public." >&2
    echo "   Unstage with: git restore --staged docs/ada-memory/personal/" >&2
    exit 1
fi

# --- Single-writer pre-flight (card kanban-commit-single-writer) ------------
# Warn-only, fires before the SSOT early-exit below so it also applies to
# non-SSOT commits. The served checkout (chaba-tony-dell) is the only one
# kanban-commit.timer sweeps — commits anywhere else only reach the board
# when pushed/merged, and stale checkouts are the source of pull stalls.
SERVED_CHECKOUT="${CHABA_SERVED_CHECKOUT:-$HOME/CascadeProjects/chaba-tony-dell}"
SW_TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$SW_TOP" ] \
   && [ "$(realpath -m "$SW_TOP" 2>/dev/null || echo "$SW_TOP")" \
        != "$(realpath -m "$SERVED_CHECKOUT" 2>/dev/null || echo "$SERVED_CHECKOUT")" ]; then
    if git diff --cached --name-only | grep -q '^docs/ssot/focus-inbox/'; then
        echo "⚠️  single-writer: docs/ssot/focus-inbox/ staged outside the served checkout" >&2
        echo "   ($SERVED_CHECKOUT). kanban-commit.timer does not sweep this checkout —" >&2
        echo "   push/merge it yourself or write the files there." >&2
    fi
    SW_UP="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null \
             || echo origin/master)"
    SW_COUNTS="$(git rev-list --left-right --count "$SW_UP...HEAD" 2>/dev/null \
                 || printf '0\t0')"
    SW_BEHIND="${SW_COUNTS%%[[:space:]]*}"; SW_AHEAD="${SW_COUNTS##*[[:space:]]}"
    SW_N="${CHABA_DIVERGENCE_N:-10}"
    if [ "${SW_BEHIND:-0}" -gt "$SW_N" ] 2>/dev/null; then
        echo "⚠️  single-writer: $SW_TOP is $SW_BEHIND commits behind $SW_UP —" >&2
        echo "   run 'git pull --rebase --autostash' before more work accumulates." >&2
    fi
    if [ "$(git branch --show-current 2>/dev/null)" = "master" ] \
       && [ "${SW_AHEAD:-0}" -gt "$SW_N" ] 2>/dev/null; then
        echo "⚠️  single-writer: $SW_TOP is $SW_AHEAD unpushed commits ahead of $SW_UP —" >&2
        echo "   the board can't see them; push or rebase soon." >&2
    fi
fi

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Validating SSOT files..."

# Check if any SSOT files are being committed
SSOT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^docs/ssot/.*\.yml$' || true)

if [ -z "$SSOT_FILES" ]; then
    echo "✅ No SSOT files changed, skipping validation"
    exit 0
fi

echo "📋 Found SSOT files to validate:"
echo "$SSOT_FILES"

# Check for YAML syntax errors
echo "🔧 Checking YAML syntax..."
for file in $SSOT_FILES; do
    if [ -f "$file" ]; then
        if ! python3 -c "import yaml; yaml.safe_load(open('$file'))" 2>/dev/null; then
            echo -e "${RED}❌ YAML syntax error in $file${NC}"
            echo "Run: python3 -c \"import yaml; yaml.safe_load(open('$file'))\""
            exit 1
        fi
    fi
done
echo -e "${GREEN}✅ YAML syntax valid${NC}"

# Check for trailing whitespace
echo "🔧 Checking for trailing whitespace..."
WHITESPACE_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^docs/ssot/.*\.yml$' | xargs grep -l '[[:space:]]$' 2>/dev/null || true)
if [ -n "$WHITESPACE_FILES" ]; then
    echo -e "${YELLOW}⚠️  Warning: Trailing whitespace found in SSOT files${NC}"
    echo "Files with trailing whitespace:"
    echo "$WHITESPACE_FILES"
    echo "Consider running: git diff --cached --name-only --diff-filter=ACM | xargs sed -i 's/[[:space:]]*$//'"
fi

# Check for IP addresses (hostname compliance)
echo "🌐 Checking hostname compliance..."
IP_ADDRESSES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^docs/ssot/.*\.yml$' | xargs grep -E '\b[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b' 2>/dev/null || true)
if [ -n "$IP_ADDRESSES" ]; then
    echo -e "${YELLOW}⚠️  Warning: IP addresses found in SSOT files (should use .local hostnames)${NC}"
    echo "$IP_ADDRESSES"
fi

# Check for unquoted URL placeholders
echo "🔧 Checking URL placeholder quoting..."
UNQUOTED_PLACEHOLDERS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^docs/ssot/.*\.yml$' | xargs grep -E 'url: \{profile\}' 2>/dev/null || true)
if [ -n "$UNQUOTED_PLACEHOLDERS" ]; then
    echo -e "${RED}❌ Unquoted URL placeholders found (causes YAML parsing errors)${NC}"
    echo "Use: url: \"{profile}/api/health\" instead of url: {profile}/api/health"
    echo "$UNQUOTED_PLACEHOLDERS"
    exit 1
fi

# Check for required fields in standard SSOT files
echo "📋 Checking required fields..."
for file in $SSOT_FILES; do
    if [ -f "$file" ]; then
        # Skip config-type files
        if echo "$file" | grep -qE '(health|gpu|services|apps)\.yml$'; then
            continue
        fi
        
        # Check for title field
        if ! grep -q '^title:' "$file"; then
            echo -e "${RED}❌ Missing required field 'title' in $file${NC}"
            exit 1
        fi
    fi
done
echo -e "${GREEN}✅ Required fields present${NC}"

# Run full SSOT validation suite
# This catches bloat, data-isolation, and structure warnings beyond basic YAML syntax.
# Guarded by script existence so lightweight checkouts (no npm install) still
# get the warn-only single-writer checks above instead of a hard failure.
if [ -f scripts/ssot-validate-all.mjs ]; then
    echo "🔍 Running full SSOT validation..."
    if ! node scripts/ssot-validate-all.mjs --staged > /tmp/ssot-precommit.log 2>&1; then
        echo -e "${RED}❌ SSOT validation failed. See /tmp/ssot-precommit.log or run 'node scripts/ssot-validate-all.mjs'.${NC}"
        tail -n 30 /tmp/ssot-precommit.log
        exit 1
    fi
    echo -e "${GREEN}✅ SSOT validation passed${NC}"
else
    echo "⚠️  scripts/ssot-validate-all.mjs not found — skipping full SSOT validation"
fi

# Preventive optimization: fail the commit if bloat/data-isolation/other warnings exist
if [ -f scripts/ssot-optimize.mjs ]; then
    echo "🎯 Running SSOT optimization check..."
    if ! node scripts/ssot-optimize.mjs --staged > /tmp/ssot-optimize-precommit.log 2>&1; then
        echo -e "${RED}❌ SSOT optimization run failed. See /tmp/ssot-optimize-precommit.log.${NC}"
        tail -n 20 /tmp/ssot-optimize-precommit.log
        exit 1
    fi

    METRICS_FILE="reports/SSOT_OPTIMIZATION_METRICS.json"
    if [ -f "$METRICS_FILE" ]; then
        BLOAT=$(python3 -c "import json; print(json.load(open('$METRICS_FILE')).get('bloat', 0))")
        DATA_ISOLATION=$(python3 -c "import json; print(json.load(open('$METRICS_FILE')).get('data_isolation', 0))")
        OTHER=$(python3 -c "import json; print(json.load(open('$METRICS_FILE')).get('other', 0))")
        if [ "$BLOAT" -gt 0 ] || [ "$DATA_ISOLATION" -gt 0 ] || [ "$OTHER" -gt 0 ]; then
            echo -e "${RED}❌ SSOT optimization warnings found (bloat: $BLOAT, data_isolation: $DATA_ISOLATION, other: $OTHER).${NC}"
            echo "Run 'node scripts/ssot-optimize.mjs' and fix the warnings before committing."
            exit 1
        fi
    fi
    echo -e "${GREEN}✅ SSOT optimization check passed${NC}"
fi

exit 0
