{
	admin localhost:2018
	auto_https off
}

http://:80 {
	log app80 {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
	@root80 path /
	handle @root80 {
		reverse_proxy 127.0.0.1:8092 {
			header_up Host 127.0.0.1:8092
		}
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up Host 127.0.0.1:8080
	}
}

http://127.0.0.1:8080 {
	bind 127.0.0.1
	root * /srv/public

	# Ensure PWA shell and catalog metadata are always revalidated
	@pwa_shell path_regexp \.(html|json|yml)$
	header @pwa_shell Cache-Control "no-cache"

	# Never let the browser or any intermediary cache the service worker
	handle /apps/sw.js {
		root * /srv/public
		file_server
		header Cache-Control "no-cache, no-store, must-revalidate"
	}

	handle /apps/gev {
		redir /apps/gev/ 308
	}

	# GEV API proxy - must come before static files
	handle /apps/gev/api/* {
		uri strip_prefix /apps/gev
		reverse_proxy 127.0.0.1:4173
	}

	handle_path /apps/gev/* {
		root * /srv/public/apps/gev
		file_server
	}
	handle /apps/gev-live {
		redir /apps/gev-live/ 308
	}
	handle_path /apps/gev-live/* {
		@ws path /ws
		handle @ws {
			reverse_proxy 127.0.0.1:8789
		}
		handle {
			root * /srv/public/apps/gev-live
			file_server
		}
	}
	# --- routes ported from the retired :8085 edge (caddy-tony-dell) 2026-09-25 ---

	# Ada HA PWAs — canonical on idc01 tailscale serve
	handle /apps/ha/ada-tony {
		redir * /apps/ha/ada-tony/ 308
	}
	handle /apps/ha/ada-tony/* {
		reverse_proxy https://idc01.taila0626a.ts.net {
			header_up Host idc01.taila0626a.ts.net
		}
	}
	handle /apps/ha/ada-michael {
		redir * /apps/ha/ada-michael/ 308
	}
	handle /apps/ha/ada-michael/* {
		reverse_proxy https://idc01.taila0626a.ts.net {
			header_up Host idc01.taila0626a.ts.net
		}
	}

	# Legacy Ada HA paths → /apps/ha/ada-*
	handle /apps/ada_ha_tony {
		redir * /apps/ha/ada-tony/ 308
	}
	handle_path /apps/ada_ha_tony/* {
		redir * /apps/ha/ada-tony{uri} 308
	}
	handle /apps/ada_ha_michael {
		redir * /apps/ha/ada-michael/ 308
	}
	handle_path /apps/ada_ha_michael/* {
		redir * /apps/ha/ada-michael{uri} 308
	}
	handle /apps/ada_ha {
		redir * /apps/ha/ada/ 308
	}
	handle_path /apps/ada_ha/* {
		redir * /apps/ha/ada{uri} 308
	}

	# ada-pi PWA retired on tony-dell — canonical instance is idc01 serve root
	handle /apps/ada_pi {
		redir * /apps/ada_pi/ 308
	}
	handle_path /apps/ada_pi/* {
		redir * https://idc01.taila0626a.ts.net{uri} 308
	}

	# HA convenience redirects
	handle /apps/ha/tony-ha {
		redir * /apps/ha/tony-ha/ 308
	}
	handle_path /apps/ha/tony-ha/* {
		redir * https://tony-dell.taila0626a.ts.net:8123/ 308
	}
	handle /apps/ha/michael-dev {
		redir * /apps/ha/michael-dev/ 308
	}
	handle_path /apps/ha/michael-dev/* {
		redir * https://tony-dell.taila0626a.ts.net:8124/ 308
	}
	handle /apps/ha/michael-ha {
		redir * /apps/ha/michael-ha/ 308
	}
	handle_path /apps/ha/michael-ha/* {
		redir * https://nupo4ndqdqydt78zmpq0z5wzp1bdrqgs.ui.nabu.casa/ 308
	}
	handle /apps/tony-ha {
		redir * /apps/ha/tony-ha/ 308
	}
	handle_path /apps/tony-ha/* {
		redir * /apps/ha/tony-ha{uri} 308
	}
	handle /apps/ha {
		redir * /apps/ha/ 308
	}

	# GEV token endpoint (separate from gev api/live)
	handle_path /apps/gev/token {
		reverse_proxy 127.0.0.1:8790 {
			header_up Host 127.0.0.1:8790
		}
	}

	# dev playground backend
	handle /apps/dev/v0 {
		redir * /apps/dev/v0/ 308
	}
	handle_path /apps/dev/v0/* {
		reverse_proxy 127.0.0.1:8006 {
			header_up Host 127.0.0.1:8006
		}
	}

	# NotebookLM cookie bridge (ai-hub extension)
	handle /apps/notebooklm-cookies {
		redir * /apps/notebooklm-cookies/ 308
	}
	handle_path /apps/notebooklm-cookies/* {
		reverse_proxy 127.0.0.1:9876 {
			header_up Host 127.0.0.1:9876
		}
	}

	# HLS static roots with CORS + segment mimetypes
	handle_path /apps/yt-live/* {
		root * /srv/public/apps/yt-live
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Headers "Origin, Range"
		header Access-Control-Expose-Headers "Content-Length, Content-Range"
		header Cache-Control "no-cache, no-store"
		@m3u8 path *.m3u8
		header @m3u8 Content-Type "application/vnd.apple.mpegurl"
		@ts path *.ts
		header @ts Content-Type "video/mp2t"
		@vtt path *.vtt
		header @vtt Content-Type "text/vtt"
		file_server
	}
	handle_path /apps/walldance-live/* {
		root * /srv/public/apps/walldance-live
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Headers "Origin, Range"
		header Access-Control-Expose-Headers "Content-Length, Content-Range"
		header Cache-Control "no-cache, no-store"
		@m3u8w path *.m3u8
		header @m3u8w Content-Type "application/vnd.apple.mpegurl"
		@tsw path *.ts
		header @tsw Content-Type "video/mp2t"
		file_server
	}
	# --- end ported :8085 routes ---

	handle /apps/yolo {
		redir /apps/yolo/ 308
	}

	handle_path /apps/yolo/* {
		root * /srv/public/apps/yolo
		file_server
	}

	handle /apps/dance2energy {
		redir /apps/dance2energy/ 308
	}

	handle_path /apps/dance2energy/* {
		root * /srv/public/apps/dance2energy
		file_server
	}

	handle /apps/vnc {
		redir /apps/vnc/ 308
	}

	handle /apps/vnc/ws {
		reverse_proxy host.containers.internal:6081
	}

	handle_path /apps/vnc/* {
		root * /srv/public/apps/vnc
		file_server
	}

	handle /snapshot {
		reverse_proxy 127.0.0.1:9005
	}

	file_server

	# Pretty URLs: /cameras → /cameras.json
	rewrite /cameras /cameras.json

	handle /chaba-h3 {
		redir /chaba-h3/ 308
	}

	handle_path /chaba-h3/* {
		root * /srv/public/chaba-h3
		file_server
	}

	@root path /
	handle @root {
		reverse_proxy 127.0.0.1:8092 {
			header_up Host 127.0.0.1:8092
		}
	}

	handle /new {
		redir /new/ 308
	}

	handle_path /new/* {
		reverse_proxy 127.0.0.1:8092 {
			header_up Host 127.0.0.1:8092
		}
	}

	handle /decisions {
		reverse_proxy 127.0.0.1:8092 {
			header_up Host 127.0.0.1:8092
		}
	}

	handle /decisions/* {
		reverse_proxy 127.0.0.1:8092 {
			header_up Host 127.0.0.1:8092
		}
	}

	handle /infrastructure {
		reverse_proxy 127.0.0.1:8092 {
			header_up Host 127.0.0.1:8092
		}
	}

	handle /infrastructure/* {
		reverse_proxy 127.0.0.1:8092 {
			header_up Host 127.0.0.1:8092
		}
	}

	handle /apps/map {
		redir /apps/map/ 308
	}

	handle /apps/map/* {
		file_server
	}

	handle /apps/rview {
		redir /apps/rview/ 308
	}

	handle_path /apps/rview/api/* {
		reverse_proxy 100.68.142.13:3007
	}

	handle_path /apps/rview/* {
		root * /srv/public/apps/rview
		file_server
	}

	handle /apps/rview-live {
		redir /apps/rview-live/ 308
	}

	handle_path /apps/rview-live/* {
		root * /srv/public/apps/rview-live
		file_server
	}

	handle_path /api/rview-live/* {
		reverse_proxy 100.68.142.13:3008
	}

	handle_path /api/gemini-mic/* {
		reverse_proxy 100.68.142.13:3009
	}

	handle /api/yomi/* {
		reverse_proxy 100.68.142.13:3000
	}

	handle_path /api/weaviate/* {
		reverse_proxy 100.68.142.13:8084
	}

	handle /api/gpu-queue/* {
		reverse_proxy 100.68.142.13:3001
	}

	# NotebookLM REST moved off the public edge 2026-09-25 — consumers use the
	# tailnet address http://100.68.142.13:3011/v1 directly (API-key gated there).

	# input-bridge relay moved to idc01 2026-09-25 (co-located with ada auth)
	handle_path /api/input-bridge/* {
		reverse_proxy 100.74.146.0:3010
	}

	handle /api/* {
		reverse_proxy 100.68.142.13:8000
	}

	# Helm proxy - /apps/helm/* to helm container (basePath configured, preserve full path)
	@apps_helm path /apps/helm /apps/helm/*
	handle @apps_helm {
		reverse_proxy helm:3000 {
			header_up Host localhost
			health_uri /apps/helm/api/health
			health_interval 30s
			health_timeout 5s
		}
	}

	handle /frigate/* {
		uri strip_prefix /frigate
		reverse_proxy frigate:5000
	}

	handle /tony-omen/apps/imagen/api/* {
		uri strip_prefix /tony-omen/apps/imagen/api
		reverse_proxy imagen-inference:8000
	}

	handle /tony-omen/apps/imagen {
		redir /tony-omen/apps/imagen/ 308
	}

	handle /tony-omen/apps/imagen/* {
		file_server
	}

	# Trade API proxy - /apps/trade/api/* to trade-api (must come before UI files)
	handle /apps/trade/api/* {
		uri strip_prefix /apps/trade
		reverse_proxy 100.68.142.13:9002 {
			header_up Host localhost
			header_up X-Forwarded-Prefix /apps/trade
		}
	}

	# Trade WebSocket proxy - /apps/trade/api/ws/* to trade-api (must come before UI files)
	handle /apps/trade/api/ws/* {
		uri strip_prefix /apps/trade
		reverse_proxy 100.68.142.13:9002 {
			header_up Host localhost
			header_up X-Forwarded-Prefix /apps/trade
			header_up Connection {>Connection}
			header_up Upgrade {>Upgrade}
		}
	}

	# Trade UI files (must come after API routes)
	handle_path /apps/trade/* {
		root * /srv/public/apps/trade
		file_server
		header Cache-Control "public, max-age=3600"
	}

	# Trade WebSocket proxy - direct /api/ws/* to trade-api
	handle /api/ws/* {
		reverse_proxy 100.68.142.13:9002 {
			header_up Host localhost
			header_up Connection {>Connection}
			header_up Upgrade {>Upgrade}
		}
	}
	redir /apps/node-red /apps/node-red/ 308

	handle /apps/node-red/* {
		reverse_proxy 127.0.0.1:1880
	}
}

