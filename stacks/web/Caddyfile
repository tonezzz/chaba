:8080 {
	root * /srv/public

	@tony_omen_temp_bare path /apps/tony-omen-temp
	redir @tony_omen_temp_bare /apps/tony-omen-temp/ 308

	# Docs serving for health check config
	handle /docs/* {
		root * /srv/docs
		file_server
	}

	# Raceman assets (must come before Activepieces to avoid conflicts)
	handle /assets/* {
		reverse_proxy host.docker.internal:8083 {
			header_up Host localhost
		}
	}

	handle /apps/common.css {
		reverse_proxy host.docker.internal:8083 {
			header_up Host localhost
		}
	}

	handle /apps/nav.js {
		reverse_proxy host.docker.internal:8083 {
			header_up Host localhost
		}
	}

	# Activepieces root-level assets (SPA loads from / due to original base href)
	@ap_assets path /assets /assets/*
	handle @ap_assets {
		reverse_proxy activepieces:80
	}

	@ap_logo path /logo.svg /logo-192.png /logo-180.png
	handle @ap_logo {
		reverse_proxy activepieces:80
	}

	handle /apps/activepieces {
		redir /apps/activepieces/ 308
	}

	handle_path /apps/activepieces/* {
		reverse_proxy activepieces:80
	}

	@raceman_noslash path /apps/raceman
	redir @raceman_noslash /apps/raceman 308

	handle /apps/raceman/* {
		reverse_proxy host.docker.internal:8083 {
			header_up Host localhost
		}
	}

	file_server

	# Docs serving for health check config
	handle /docs/* {
		root * /srv/docs
		file_server
	}

	# Pretty URLs: /cameras → /cameras.json
	rewrite /cameras /cameras.json


	@root path /
	handle @root {
		reverse_proxy bserver:8092 {
			header_up Host bserver.local
		}
	}

	handle /new {
		redir /new/ 308
	}

	handle_path /new/* {
		reverse_proxy bserver:8092 {
			header_up Host bserver.local
		}
	}

	handle /decisions {
		reverse_proxy bserver:8092 {
			header_up Host bserver.local
		}
	}

	handle /decisions/* {
		reverse_proxy bserver:8092 {
			header_up Host bserver.local
		}
	}

	handle /chatlocal {
		redir /chatlocal/ 308
	}

	handle_path /chatlocal/* {
		reverse_proxy host.docker.internal:3000 {
			header_up Host localhost:3000
		}
	}

	@yomi_noslash path /apps/yomi
	redir @yomi_noslash /apps/yomi/ 308

	handle_path /apps/yomi/* {
		root * /srv/public/apps/yomi
		file_server
	}

	# Yomi API proxy
	@yomi_api path /api/yomi/*
	handle @yomi_api {
		reverse_proxy host.docker.internal:3000 {
			header_up Host localhost
		}
	}

	@chatlocal path /apps/chatlocal /apps/chatlocal/*
	handle @chatlocal {
		reverse_proxy host.docker.internal:3000 {
			header_up Host localhost:3000
		}
	}
}