:8080 {
	root * /srv/public

	@tony_omen_temp_bare path /apps/tony-omen-temp
	redir @tony_omen_temp_bare /apps/tony-omen-temp/ 308

	file_server

	# Pretty URLs: /cameras → /cameras.json
	rewrite /cameras /cameras.json


	@root path /
	handle @root {
		reverse_proxy bserver:8092 {
			header_up Host bserver.local
		}
	}

	handle /new {
		redir /new/ 308
	}

	handle_path /new/* {
		reverse_proxy bserver:8092 {
			header_up Host bserver.local
		}
	}

	handle /decisions {
		reverse_proxy bserver:8092 {
			header_up Host bserver.local
		}
	}

	handle /decisions/* {
		reverse_proxy bserver:8092 {
			header_up Host bserver.local
		}
	}

	handle /infrastructure {
		reverse_proxy bserver:8092 {
			header_up Host bserver.local
		}
	}

	handle /infrastructure/* {
		reverse_proxy bserver:8092 {
			header_up Host bserver.local
		}
	}

	handle /apps/map {
		redir /apps/map/ 308
	}

	handle /apps/map/* {
		file_server
	}

	handle /api/* {
		reverse_proxy status-api:8000
	}

	handle /frigate/* {
		uri strip_prefix /frigate
		reverse_proxy frigate:5000
	}

	handle /tony-omen/apps/imagen/api/* {
		uri strip_prefix /tony-omen/apps/imagen/api
		reverse_proxy imagen-inference:8000
	}

	handle /tony-omen/apps/imagen {
		redir /tony-omen/apps/imagen/ 308
	}

	handle /tony-omen/apps/imagen/* {
		file_server
	}

	@tony_omen_exact path /tony-omen /tony-omen/
	redir @tony_omen_exact /apps/tony-omen-temp/ 308

	handle /apps/tony-omen-temp {
		redir /apps/tony-omen-temp/ 308
	}

	handle_path /apps/tony-omen-temp/* {
		root * /srv/public/tony-omen
		file_server
	}

	@imagen2_noslash path /apps/imagen2
	redir @imagen2_noslash /apps/imagen2/ 308

	handle_path /apps/imagen2/api/* {
		reverse_proxy imagen2-inference:8000
	}

	handle_path /apps/imagen2/* {
		root * /srv/public/tony-omen/apps/imagen2
		file_server
	}

	handle /apps/imagen {
		redir /apps/imagen/ 308
	}

	handle_path /apps/imagen/api/* {
		reverse_proxy imagen-inference:8000
	}

	handle_path /apps/imagen/* {
		root * /srv/public/tony-omen/apps/imagen
		file_server
	}

	@yomi_noslash path /apps/yomi
	redir @yomi_noslash /apps/yomi/ 308

	handle_path /apps/yomi/* {
		root * /srv/public/apps/yomi
		basicauth {
			yomi {env.YOMI_PASSWORD_HASH}
		}
		file_server
	}

	@chatlocal path /apps/chatlocal /apps/chatlocal/*
	handle @chatlocal {
		reverse_proxy host.docker.internal:3000 {
			header_up Host localhost:3000
		}
	}

	@neo_chat path /apps/neo-chat /apps/neo-chat/*
	handle @neo_chat {
		reverse_proxy host.docker.internal:3001 {
			header_up Host localhost:3001
		}
	}

	@chatllama_noslash path /apps/chatllama
	redir @chatllama_noslash /apps/chatllama/ 308

	handle /v1/* {
		reverse_proxy host.docker.internal:8008 {
			header_up Host localhost:8008
		}
	}

	handle_path /apps/chatllama/* {
		reverse_proxy host.docker.internal:8008 {
			header_up Host localhost:8008
			header_up Accept-Encoding gzip
		}
	}

	handle /socket.io/* {
		reverse_proxy host.docker.internal:3000 {
			header_up Host localhost:3000
		}
	}
}

# chaba.h3 local dev root
:8081 {
	root * /srv/public/chaba-h3

	handle /apps/track4/api/* {
		reverse_proxy host.docker.internal:8123
	}

	file_server
}
