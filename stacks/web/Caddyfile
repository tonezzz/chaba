:8080 {
	root * /srv/public
	file_server

	# Pretty URLs: /cameras → /cameras.json
	rewrite /cameras /cameras.json

	handle /chaba-h3 {
		redir /chaba-h3/ 308
	}

	handle_path /chaba-h3/* {
		root * /srv/public/chaba-h3
		file_server
	}

	@root path /
	handle @root {
		reverse_proxy 127.0.0.1:8092 {
			header_up Host 127.0.0.1:8092
		}
	}

	handle /new {
		redir /new/ 308
	}

	handle_path /new/* {
		reverse_proxy 127.0.0.1:8092 {
			header_up Host 127.0.0.1:8092
		}
	}

	handle /decisions {
		reverse_proxy 127.0.0.1:8092 {
			header_up Host 127.0.0.1:8092
		}
	}

	handle /decisions/* {
		reverse_proxy 127.0.0.1:8092 {
			header_up Host 127.0.0.1:8092
		}
	}

	handle /infrastructure {
		reverse_proxy 127.0.0.1:8092 {
			header_up Host 127.0.0.1:8092
		}
	}

	handle /infrastructure/* {
		reverse_proxy 127.0.0.1:8092 {
			header_up Host 127.0.0.1:8092
		}
	}

	handle /apps/map {
		redir /apps/map/ 308
	}

	handle /apps/map/* {
		file_server
	}

	handle /apps/rview {
		redir /apps/rview/ 308
	}

	handle_path /apps/rview/api/* {
		reverse_proxy 100.68.142.13:3007
	}

	handle_path /apps/rview/* {
		root * /srv/public/apps/rview
		file_server
	}

	handle /apps/rview-live {
		redir /apps/rview-live/ 308
	}

	handle_path /apps/rview-live/* {
		root * /srv/public/apps/rview-live
		file_server
	}

	handle_path /api/rview-live/* {
		reverse_proxy 100.68.142.13:3008
	}

	handle /api/yomi/* {
		reverse_proxy 100.68.142.13:3000
	}

	handle_path /api/weaviate/* {
		reverse_proxy 100.68.142.13:8084
	}

	handle /api/gpu-queue/* {
		reverse_proxy 100.68.142.13:3001
	}

	handle /api/* {
		reverse_proxy 100.68.142.13:8000
	}

	handle /frigate/* {
		uri strip_prefix /frigate
		reverse_proxy frigate:5000
	}

	handle /tony-omen/apps/imagen/api/* {
		uri strip_prefix /tony-omen/apps/imagen/api
		reverse_proxy imagen-inference:8000
	}

	handle /tony-omen/apps/imagen {
		redir /tony-omen/apps/imagen/ 308
	}

	handle /tony-omen/apps/imagen/* {
		file_server
	}

	# Trade API proxy - /apps/trade/api/* to trade-api (must come before UI files)
	handle /apps/trade/api/* {
		uri strip_prefix /apps/trade
		reverse_proxy 100.68.142.13:9002 {
			header_up Host localhost
			header_up X-Forwarded-Prefix /apps/trade
		}
	}

	# Trade WebSocket proxy - /apps/trade/api/ws/* to trade-api (must come before UI files)
	handle /apps/trade/api/ws/* {
		uri strip_prefix /apps/trade
		reverse_proxy 100.68.142.13:9002 {
			header_up Host localhost
			header_up X-Forwarded-Prefix /apps/trade
			header_up Connection {>Connection}
			header_up Upgrade {>Upgrade}
		}
	}

	# Trade UI files (must come after API routes)
	handle_path /apps/trade/* {
		root * /srv/public/apps/trade
		file_server
		header Cache-Control "public, max-age=3600"
	}

	# Trade WebSocket proxy - direct /api/ws/* to trade-api
	handle /api/ws/* {
		reverse_proxy 100.68.142.13:9002 {
			header_up Host localhost
			header_up Connection {>Connection}
			header_up Upgrade {>Upgrade}
		}
	}
}

# chaba.h3 local dev root
:8081 {
	root * /srv/public/chaba-h3
	file_server
}
