[Unit]
Description=Headless vcast display (screen %i) — deterministic test screen
After=input-bridge.service

# Deterministic protocol-level vcast displays for live scenario runs.
# Deploy on idc03 (the relay host): ~/.config/systemd/user/vcast-headless@.service
#   systemctl --user enable --now vcast-headless@2 vcast-headless@4
# Slot numbering: /claim with name "screen-%i" takes slot %i when free,
# else the lowest free slot. The minted key persists in
# %h/.local/share/vcast-headless/screen-%i.key so restarts skip /claim
# entirely; a stale ada key pinning the name is force-claimed away by the
# client (no manual /release needed since 2026-10-07).

[Service]
EnvironmentFile=%h/.config/secrets/input-bridge.env
Environment=VCAST_NAME=screen-%i
Environment=VCAST_LABEL=headless-%i
Environment=VCAST_DEV_ID=headless-%i
Environment=VCAST_KEY_FILE=/state/screen-%i.key
ExecStart=/usr/bin/podman run --name=vcast-headless-%i --replace --rm --network=host -v %h/apps/input-bridge:/app:ro,Z -v %h/.local/share/vcast-headless:/state:Z -w /app --env ADA_ADMIN_KEY --env VCAST_NAME --env VCAST_LABEL --env VCAST_DEV_ID --env VCAST_KEY_FILE docker.io/library/node:22-alpine node vcast-headless.mjs ws://127.0.0.1:3010/ws http://127.0.0.1:3010
ExecStop=/usr/bin/podman stop -t 3 vcast-headless-%i
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
