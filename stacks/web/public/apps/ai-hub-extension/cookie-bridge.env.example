# AI Hub cookie bridge configuration
# Copy to ~/.config/ai-hub/cookie-bridge.env and edit for the host.

# Where to write the captured cookies on this host.
STORAGE=/home/tony/.notebooklm/profiles/default/storage_state.json

# Optional: rsync the storage file to another host (e.g. tony-dell).
# Leave empty to skip.
# RSYNC_TARGET=tony-dell:/home/tony/.local/share/notebooklm/notebooklm/storage_state.json

# Optional: command to restart the notebooklm-rest service after writing.
# Leave empty to skip.
# RESTART_CMD=ssh -o BatchMode=yes tony-dell 'systemctl --user restart notebooklm-rest'
