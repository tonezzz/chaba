# Tony OpenCode public root host. Cloudflare Access and the Tony gateway
# independently authenticate the request before private upstream proxying.
opencode-tony.surf-thailand.com {
	bind 45.136.236.190
	tls internal
	reverse_proxy http://127.0.0.1:8378 {
		header_up Host {http.request.host}
		header_up Origin {http.request.header.Origin}
		header_up Cf-Access-Jwt-Assertion {http.request.header.Cf-Access-Jwt-Assertion}
		header_up -Authorization
	}
}
