# ~/.config/secrets/jack-enroll.env — admin/upstream credentials for the
# jack-enroll gateway pod (chmod 600).
# Required for /admin/* ops (mint/revoke/reset/status/audit).
JACK_ADMIN_TOKEN=<openssl rand -hex 24>
# Must equal OPENCODE_SERVER_PASSWORD in jack-ide.env (user "opencode").
JACK_UPSTREAM_PASSWORD=<same-as-OPENCODE_SERVER_PASSWORD>
