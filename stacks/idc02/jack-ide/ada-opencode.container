[Unit]
Description=Protected Ada OpenCode control-plane backend
After=ada-opencode.network
Requires=ada-opencode.network

[Container]
Image=localhost/ada-opencode:latest
ContainerName=ada-opencode
Network=ada-opencode.network
UserNS=keep-id
Environment=HOME=/home/opencode
EnvironmentFile=%h/.config/secrets/ada-opencode.env
# OpenCode writes harmless project metadata (.opencode/.gitignore and
# session-local state) in the workspace. The Ada agent itself remains
# tool/shell/edit restricted by workspace config; credentials stay in the
# separate EnvironmentFile and are never mounted from this tree.
Volume=%h/.local/share/ada-opencode/workspace:/workspace:Z
Volume=%h/.local/share/ada-opencode/home:/home/opencode:Z
Volume=%h/.local/share/ada-opencode/devin-summaries:/home/opencode/.local/share/devin:ro,Z
# Host-side rclone sync publishes only the Ada Nest index/artifact tree here.
# The container must never write to the Drive-backed source.
Volume=%h/.local/share/ada-opencode/gdrive:/data/gdrive:ro,Z
HealthCmd=/usr/local/bin/node -e "fetch('http://127.0.0.1:4096/global/health',{headers:{authorization:'Basic '+Buffer.from('opencode:'+process.env.OPENCODE_SERVER_PASSWORD).toString('base64')}}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=60s

[Service]
Restart=always
RestartSec=10
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=default.target
