# ~/.config/secrets/jack-ide.env — container-side credentials for the
# jack-opencode pod (chmod 600). Never mounted into browser-reachable state.
# Basic-auth on the opencode upstream itself (user "opencode") — the gateway
# injects this server-side so even the podnet path is authenticated.
OPENCODE_SERVER_PASSWORD=<openssl rand -base64 24>
# LiteLLM virtual key for the IDE's model calls. Placeholder = shared key
# from litellm-chaba.env; replace with a dedicated jack-scoped virtual key
# (minted by the LiteLLM proxy admin) once issued — see stack README.
LITELLM_KEY=<sk-...>
