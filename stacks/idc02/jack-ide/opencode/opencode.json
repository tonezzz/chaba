{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM Proxy",
      "options": {
        "baseURL": "http://100.102.134.91:4000/v1"
      },
      "models": {
        "gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite (proxy)"
        },
        "gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash (proxy)"
        },
        "or-gemini-3.5-flash-lite": {
          "name": "OpenRouter Gemini 3.5 Flash Lite"
        },
        "ollama-qwen7b": {
          "name": "Local Qwen2.5 7B"
        },
        "or-free-gemma31b": {
          "name": "OpenRouter Gemma 31B (free)"
        }
      }
    }
  },
  "model": "litellm/gemini-3.5-flash-lite",
  "mcp": {},
  "permission": {
    "external_directory": "deny",
    "edit": "allow",
    "bash": "ask",
    "doom_loop": "ask"
  },
  "agent": {
    "ada": {
      "mode": "primary",
      "model": "litellm/gemini-3.5-flash-lite",
      "prompt": "You are Ada in the Jack OpenCode worker. Work only within the declared workspace and task scope. Be explicit about evidence, tests, blockers, and next actions. Never claim a dispatch, write, merge, deployment, or external action happened without a tool result. This worker has no Ada voice-memory MCP; treat the task prompt and repository context as the available context.",
      "permission": {
        "external_directory": "deny",
        "edit": "allow",
        "bash": "ask",
        "webfetch": "deny",
        "doom_loop": "ask"
      }
    }
  }
}
