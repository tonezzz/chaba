[Unit]
Description=Protected Ada OpenCode Access gateway
After=ada-code.service
Requires=ada-code.service

[Container]
Image=localhost/ada-enroll:latest
ContainerName=ada-code-enroll
Network=ada-code.network
UserNS=keep-id
PublishPort=127.0.0.1:8378:8080
Environment=LISTEN_PORT=8080
Environment=UPSTREAM_URL=http://ada-code:4096
Environment=UPSTREAM_USER=opencode
Environment=STATE_DIR=/state
Environment=SESSION_TTL_S=43200
Environment=REQUIRE_EDGE_HEADER=1
Environment=AUTO_ENROLL_ACCESS=1
Environment=COOKIE_NAME=ada_opencode_sess
Environment=PUBLIC_HOST=ada-code.surf-thailand.com
Environment=CF_ACCESS_ISSUER=https://chaba-team.cloudflareaccess.com
Environment=CF_ACCESS_AUDIENCE=3ffbe55bca47840e87e421b0e99abe1ab47f3312930c60ac9b02cfd0817a7973
Environment=CF_ACCESS_JWKS_URL=https://chaba-team.cloudflareaccess.com/cdn-cgi/access/certs
Environment=COOKIE_SECURE=1
EnvironmentFile=%h/.config/secrets/ada-code.env
Volume=%h/.local/share/ada-code/state:/state:Z
HealthCmd=/usr/local/bin/node -e "fetch('http://127.0.0.1:8080/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=30s

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
