# ~/.config/secrets/jack-git.env — chmod 600. HOST SIDE ONLY: this file is
# never mounted into the jack-opencode container. Used by `jack-task push`
# and `jack-task pr` on idc02.
#
# Mint a FINE-GRAINED PAT (github.com -> Settings -> Developer settings ->
# Fine-grained tokens), NOT a classic PAT:
#   - Repository access: "Only select repositories" -> the pilot repos
#   - Permissions: Contents = Read and write, Pull requests = Read and write
#   - Expiration: shortest practical (90d), rotate via this file
# A GitHub App installation token is the upgrade path if the pilot grows.
JACK_GIT_TOKEN=github_pat_...
