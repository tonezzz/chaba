# ---- OPS-0725 ph1: tailnet service front (2026-10-16) ----
# Stable internal front door so consumers stop hardcoding
# tony-dell.taila0626a.ts.net (152 refs today). Upstreams flip HERE during
# the dell migration (docs/kb/host-migration-tony-dell.md); consumers
# repoint once to idc02.taila0626a.ts.net and never move again.
#
# Two surfaces:
#   :8088 — loopback-only; `tailscale serve` fronts it at
#           https://idc02.taila0626a.ts.net:443 (real cert). Wholesale
#           passthrough of the dell web-stack URL space (/apps/*, /api/*).
#           Per-service `handle` blocks get added above this as services
#           scatter (board-api -> idc03, cams -> omen, ...).
#   shadow ports — bound to the tailnet IP only, SAME port numbers as dell
#           so consumers change just the hostname (http on wireguard is
#           already encrypted; upstreams stay https). 8123=tony-ha,
#           8124=tony-test, 8125=ada-ha, 8444/8446=serve mounts
#           (:9005/:9101), 9230=input-bridge, 3002=monitoring-dashboard.

http://:8088 {
	bind 127.0.0.1
	# board-api migrated to idc03 2026-10-16 (OPS-0725 ph2) — same guard
	# shape as dell web: writes need a tailnet identity header
	handle /apps/board-api {
		redir * /apps/board-api/ 308
	}
	handle_path /apps/board-api/* {
		@anon_write_board-api {
			not method GET HEAD
			not header Tailscale-User-Login *
		}
		respond @anon_write_board-api "forbidden: board-api writes need a tailnet identity" 403
		reverse_proxy https://idc03.taila0626a.ts.net:10000 {
			header_up Host idc03.taila0626a.ts.net
		}
	}
	reverse_proxy http://127.0.0.1:8099 {
		header_up Host idc02-web-origin
	}
}

http://:8123 {
	bind 100.123.163.11
	reverse_proxy https://tony-omen.taila0626a.ts.net:8123 {
		header_up Host tony-omen.taila0626a.ts.net
	}
}

http://:8124 {
	bind 100.123.163.11
	# michael-dev on idc03 (migrated 2026-10-09; was tony-test on dell)
	reverse_proxy https://idc03.taila0626a.ts.net:8124 {
		header_up Host idc03.taila0626a.ts.net
	}
}

http://:8125 {
	bind 100.123.163.11
	reverse_proxy https://tony-omen.taila0626a.ts.net:8125 {
		header_up Host tony-omen.taila0626a.ts.net
	}
}

http://:8444 {
	bind 100.123.163.11
	reverse_proxy https://tony-omen.taila0626a.ts.net:8444 {
		header_up Host tony-omen.taila0626a.ts.net
	}
}

http://:8446 {
	bind 100.123.163.11
	# mcp-debug-sse retired with dell evacuation 2026-10-20 — no live
	# :9101 backend anywhere (mn01 mcp-link-monitor is outbound-only)
	respond "mcp-debug-sse retired — see OPS-0725" 503
}

http://:9230 {
	bind 100.123.163.11
	# input-bridge on idc03 :3010 (INPUT_BRIDGE_PORT) — dell shadow retired
	reverse_proxy http://idc03.taila0626a.ts.net:3010
}

http://:3002 {
	bind 100.123.163.11
	reverse_proxy http://127.0.0.1:3002
}

# status-data-api — migrated from tony-dell 2026-10-17 (OPS-0725 ph3); loopback service, tailnet shadow
http://:8000 {
	bind 100.123.163.11
	reverse_proxy http://127.0.0.1:8000
}

# chaba-report-api — migrated from tony-dell 2026-10-17 (OPS-0725 ph3)
http://:8792 {
	bind 100.123.163.11
	reverse_proxy http://127.0.0.1:8792
}
