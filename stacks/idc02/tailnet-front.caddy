# ---- OPS-0725 ph1: tailnet service front (2026-10-16) ----
# Stable internal front door so consumers stop hardcoding
# tony-dell.taila0626a.ts.net (152 refs today). Upstreams flip HERE during
# the dell migration (docs/kb/host-migration-tony-dell.md); consumers
# repoint once to idc02.taila0626a.ts.net and never move again.
#
# Two surfaces:
#   :8088 — loopback-only; `tailscale serve` fronts it at
#           https://idc02.taila0626a.ts.net:443 (real cert). Wholesale
#           passthrough of the dell web-stack URL space (/apps/*, /api/*).
#           Per-service `handle` blocks get added above this as services
#           scatter (board-api -> idc03, cams -> omen, ...).
#   shadow ports — bound to the tailnet IP only, SAME port numbers as dell
#           so consumers change just the hostname (http on wireguard is
#           already encrypted; upstreams stay https). 8123=tony-ha,
#           8124=tony-test, 8125=ada-ha, 8444/8446=serve mounts
#           (:9005/:9101), 9230=input-bridge, 3002=monitoring-dashboard.

# NOTE: `http://:8088` + bind — a `127.0.0.1` site address is a host
# matcher, NOT a bind; it still listens on *.
http://:8088 {
	bind 127.0.0.1
	reverse_proxy https://tony-dell.taila0626a.ts.net {
		header_up Host tony-dell.taila0626a.ts.net
	}
}

http://:8123 {
	bind 100.123.163.11
	reverse_proxy https://tony-dell.taila0626a.ts.net:8123 {
		header_up Host tony-dell.taila0626a.ts.net
	}
}

http://:8124 {
	bind 100.123.163.11
	reverse_proxy https://tony-dell.taila0626a.ts.net:8124 {
		header_up Host tony-dell.taila0626a.ts.net
	}
}

http://:8125 {
	bind 100.123.163.11
	reverse_proxy https://tony-dell.taila0626a.ts.net:8125 {
		header_up Host tony-dell.taila0626a.ts.net
	}
}

http://:8444 {
	bind 100.123.163.11
	reverse_proxy https://tony-dell.taila0626a.ts.net:8444 {
		header_up Host tony-dell.taila0626a.ts.net
	}
}

http://:8446 {
	bind 100.123.163.11
	reverse_proxy https://tony-dell.taila0626a.ts.net:8446 {
		header_up Host tony-dell.taila0626a.ts.net
	}
}

http://:9230 {
	bind 100.123.163.11
	reverse_proxy http://tony-dell.taila0626a.ts.net:9230
}

http://:3002 {
	bind 100.123.163.11
	reverse_proxy http://tony-dell.taila0626a.ts.net:3002
}
