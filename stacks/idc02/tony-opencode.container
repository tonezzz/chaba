# Tony's separate OpenCode instance. The primary workspace is Tony's; the
# Jack workspace is additionally visible because Tony explicitly requested
# mutual read/write access for this supervised test.
[Unit]
Description=Tony isolated OpenCode IDE (rootless podman)
After=tony-ide-network.service
Requires=tony-ide-network.service

[Container]
Image=localhost/jack-opencode:latest
ContainerName=tony-opencode
Network=tony-ide.network
UserNS=keep-id
Environment=HOME=/home/opencode
EnvironmentFile=%h/.config/secrets/tony-ide.env
Volume=%h/.local/share/tony-ide/workspace:/workspace:Z
Volume=%h/.local/share/jack-ide/workspace:/workspace/jack-workspace:Z
Volume=%h/.local/share/tony-ide/opencode-home:/home/opencode:Z
Volume=%h/.config/tony-ide/opencode.json:/home/opencode/.config/opencode/opencode.json:ro,Z
HealthCmd=/usr/local/bin/node -e "fetch('http://127.0.0.1:4096/global/health',{headers:{authorization:'Basic '+Buffer.from('opencode:'+process.env.OPENCODE_SERVER_PASSWORD).toString('base64')}}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=60s

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=120
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=default.target
