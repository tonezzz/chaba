diff --git a/packages/web/server/lib/openchamber-control/models-status.ts b/packages/web/server/lib/openchamber-control/models-status.ts
new file mode 100644
index 0000000..efc8fe8
--- /dev/null
+++ b/packages/web/server/lib/openchamber-control/models-status.ts
@@ -0,0 +1,128 @@
+import { asNonEmptyString, isRecord, isString } from '../shared/guards.js';
+import type { JsonValue } from '../shared/json-values.js';
+import type { ModelInfo } from '@opencode/client';
+import { getProviderAuth } from '../opencode/auth.js';
+import { readLocationCatalog } from '../opencode/location-plugins.js';
+import type { ControlInput } from './contracts.js';
+import type { ControlClient } from './opencode-client.js';
+
+const MODELS_STATUS_PROBE_TIMEOUT_MS = 10_000;
+const CHAT_COMPLETIONS_PROBE_PACKAGES = new Set([
+  'aisdk:@ai-sdk/openai',
+  'aisdk:@ai-sdk/openai-compatible',
+  '@opencode/ai/providers/openai',
+  '@opencode/ai/providers/openai/chat',
+  '@opencode/ai/providers/openai-compatible',
+  '@opencode/ai/providers/openai-compatible-responses',
+]);
+
+const resolveConfiguredSecret = (value: JsonValue | undefined): string | null => {
+  const text = asNonEmptyString(value);
+  if (!text) return null;
+  const envName = /^\{env:([A-Za-z_][A-Za-z0-9_]*)\}$/.exec(text)?.[1];
+  if (envName) return asNonEmptyString(process.env[envName]) ?? null;
+  return text.startsWith('{') ? null : text;
+};
+
+interface ModelsStatusProbeTarget {
+  baseURL: string;
+  apiKey: string | null;
+  headers: Record<string, string>;
+  modelID: string;
+}
+
+const probeChatCompletionsModel = async ({ baseURL, apiKey, headers, modelID }: ModelsStatusProbeTarget) => {
+  const base = baseURL.replace(/\/+$/, '');
+  const requestHeaders = { ...headers };
+  requestHeaders['content-type'] = 'application/json';
+  if (apiKey) requestHeaders.authorization = `Bearer ${apiKey}`;
+  try {
+    const response = await fetch(`${base}/chat/completions`, {
+      method: 'POST',
+      headers: requestHeaders,
+      body: JSON.stringify({ model: modelID, messages: [{ role: 'user', content: 'ok' }], max_tokens: 1 }),
+      signal: AbortSignal.timeout(MODELS_STATUS_PROBE_TIMEOUT_MS),
+    });
+    if (response.ok) return { status: 'active', detail: null };
+    const body: unknown = await response.json().catch(() => null);
+    const error = isRecord(body) ? body.error : null;
+    const detail = isRecord(error) ? error.message : error;
+    return { status: 'unavailable', detail: asNonEmptyString(detail) ?? String(response.status) };
+  } catch (error) {
+    return { status: 'error', detail: error instanceof Error ? error.message : String(error) };
+  }
+};
+
+export interface ModelsStatusDependencies {
+  getClient: (directory?: string | null) => Promise<ControlClient>;
+}
+
+export const createModelsStatusAction = ({ getClient }: ModelsStatusDependencies) => async (input: ControlInput, contextDirectory: ControlInput['directory']) => {
+  const client = await getClient(asNonEmptyString(input.directory) || asNonEmptyString(contextDirectory) || '');
+  const [catalog, providerList] = await readLocationCatalog(client);
+  const providersByID = new Map(providerList.data.map((provider) => [provider.id, provider]));
+  const providerNames = new Map(providerList.data.map((provider) => [provider.id, provider.name]));
+  const providerFilter = asNonEmptyString(input.provider)?.toLowerCase();
+  const storedKeys = new Map<string, Promise<string | null>>();
+  const storedKey = (providerID: string) => {
+    let pending = storedKeys.get(providerID);
+    if (!pending) {
+      pending = getProviderAuth(providerID)
+        .then((auth) => (auth?.type === 'api' ? asNonEmptyString(auth.key) ?? null : null))
+        .catch(() => null);
+      storedKeys.set(providerID, pending);
+    }
+    return pending;
+  };
+  const probeTarget = (model: ModelInfo): ModelsStatusProbeTarget | null => {
+    const provider = providersByID.get(model.providerID);
+    const packageName = model.package ?? provider?.package;
+    if (!provider || !isString(packageName) || !CHAT_COMPLETIONS_PROBE_PACKAGES.has(packageName)) return null;
+    const baseURL = [model.settings?.baseURL, provider.settings?.baseURL]
+      .map((value) => asNonEmptyString(value))
+      .find((value) => value !== null && /^https?:\/\//.test(value));
+    if (!baseURL) return null;
+    const headers: Record<string, string> = {};
+    for (const source of [provider.headers, model.headers]) {
+      for (const [name, value] of Object.entries(source ?? {})) {
+        if (isString(value)) headers[name] = value;
+      }
+    }
+    return {
+      baseURL,
+      headers,
+      apiKey: resolveConfiguredSecret(model.settings?.apiKey) ?? resolveConfiguredSecret(provider.settings?.apiKey),
+      modelID: model.id,
+    };
+  };
+  const seen = new Set<string>();
+  const matching = catalog.data.filter((model) => {
+    const key = `${model.providerID}/${model.id}`;
+    if (seen.has(key)) return false;
+    seen.add(key);
+    if (!providerFilter) return true;
+    return model.providerID.toLowerCase() === providerFilter
+      || String(providerNames.get(model.providerID) ?? '').toLowerCase() === providerFilter;
+  });
+  const models = await Promise.all(matching.map(async (model) => {
+    const target = probeTarget(model);
+    const probe = target
+      ? await probeChatCompletionsModel({ ...target, apiKey: target.apiKey ?? await storedKey(model.providerID) })
+      : null;
+    return {
+      providerID: model.providerID,
+      modelID: model.id,
+      name: model.name,
+      status: probe?.status ?? String(model.status ?? 'active'),
+      detail: probe?.detail ?? null,
+      catalogStatus: String(model.status ?? 'active'),
+    };
+  }));
+  const summary = {
+    total: models.length,
+    unavailable: models.filter((model) => model.status === 'unavailable').length,
+    error: models.filter((model) => model.status === 'error').length,
+    active: models.filter((model) => model.status === 'active').length,
+  };
+  return { models, summary, provider: providerFilter };
+};
