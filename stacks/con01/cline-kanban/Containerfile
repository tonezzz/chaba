FROM docker.io/library/node:22.20.0-bookworm-slim

ENV npm_config_update_notifier=false
WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates git g++ make python3 \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global --no-audit --no-fund kanban@0.1.70 \
    && sed -i 's/options\.noPasscode === true/options.passcode === false || options.noPasscode === true/' /usr/local/lib/node_modules/kanban/dist/cli.js \
    && sed -i 's/if (options\.noPasscode) {/if (options.passcode === false || options.noPasscode) {/' /usr/local/lib/node_modules/kanban/dist/cli.js

COPY entrypoint.sh proxy.mjs proxy-policy.mjs /opt/cline-kanban/

RUN chmod 0755 /opt/cline-kanban/entrypoint.sh

ENTRYPOINT ["/opt/cline-kanban/entrypoint.sh"]
