FROM docker.io/library/node:22.20.0-bookworm-slim

ENV npm_config_update_notifier=false
WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates git g++ make python3 \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global --no-audit --no-fund kanban@0.1.70

ENTRYPOINT ["kanban"]
CMD ["--host", "0.0.0.0", "--port", "3484", "--no-open"]
