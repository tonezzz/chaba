[Unit]
Description=Ada Telegram two-way relay (ada-tg-relay)
After=network.target ada-ha-tony.service

[Service]
Type=simple
WorkingDirectory=%h/CascadeProjects/ada-pi
EnvironmentFile=%h/.config/secrets/ada-ha-tony.env
EnvironmentFile=%h/.config/secrets/telegram-bot.env
ExecStart=%h/CascadeProjects/ada-pi/.venv/bin/python -m backend.tg_relay
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
