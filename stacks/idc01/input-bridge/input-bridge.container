# input-bridge quadlet — WS relay + vcast display registry on idc01.
# Deployed live at ~/.config/containers/systemd/input-bridge.container
[Container]
ContainerName=input-bridge
Image=docker.io/library/node:22-alpine
Network=host
Volume=%h/apps/input-bridge:/app:ro,Z
Volume=%h/.local/share/input-bridge:/data:Z
EnvironmentFile=%h/.config/secrets/input-bridge.env
Environment=INPUT_BRIDGE_PORT=3010
Environment=ADA_AUTH_URL=http://127.0.0.1:8001
Environment=VCAST_REGISTRY=/data/displays.json
Environment=VCAST_REDEEM_HOSTS=127.0.0.1,localhost,idc01.taila0626a.ts.net,tony-dell.taila0626a.ts.net,mn01.taila0626a.ts.net
WorkingDir=/app
Exec=node server.mjs

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
