[Unit]
Description=Ollama local inference (embedding fallback for mddb)

[Container]
Image=docker.io/ollama/ollama:latest
ContainerName=ollama
Network=host
Environment=OLLAMA_HOST=100.74.146.0:11434
Environment=OLLAMA_KEEP_ALIVE=5m
Volume=ollama-data:/root/.ollama

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
