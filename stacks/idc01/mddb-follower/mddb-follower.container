[Unit]
Description=mddb document database (read-only follower of idc03, on idc01)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/mddb:2.15.4-lsn
ContainerName=mddb-follower
Network=host
Volume=%h/.config/containers/mddb-follower/data:/app/data:U
Volume=%h/.config/containers/mddb-follower/vaults:/vaults:U
Environment=MDDB_ADDR=100.74.146.0:11123
Environment=MDDB_GRPC_ADDR=100.74.146.0:11124
Environment=MDDB_MCP_ENABLED=false
Environment=MDDB_MCP_STDIO=false
Environment=MDDB_PATH=/app/data/mddb.db
Environment=MDDB_VERIFY_TIMEOUT=6h
Environment=MDDB_MODE=ro
Environment=MDDB_HTTP_ENABLED=true
Environment=MDDB_GRPC_ENABLED=true
Environment=MDDB_HTTP3_ENABLED=false
Environment=MDDB_TLS_ENABLED=false
Environment=MDDB_CORS_ORIGINS=*
Environment=MDDB_LOG_LEVEL=INFO
Environment=MDDB_RATE_LIMIT_ENABLED=false
Environment=MDDB_AUDIT_ENABLED=false
Environment=MDDB_AUTH_ENABLED=false
Environment=MDDB_PRODUCTION=false
Environment=MDDB_REPLICATION_ROLE=follower
Environment=MDDB_NODE_ID=idc01
Environment=MDDB_REPLICATION_LEADER_ADDR=100.102.134.91:11024
Environment=MDDB_REPLICATION_SECRET=ebb87d729413dfcd2a17ce3fee3b6cf0c0f899b4b781b0c390d96d5a134a3345
Environment=TZ=Asia/Bangkok
Environment=MDDB_VECTOR_ALGORITHMS=flat,quantized
Environment=MDDB_FREELIST_SYNC=true

[Service]
Restart=on-failure
TimeoutStopSec=70

[Install]
WantedBy=default.target
