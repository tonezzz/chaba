[Unit]
Description=Ada HA Michael backend
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/CascadeProjects/ada-voice
EnvironmentFile=%h/.config/secrets/ada-ha-michael.env
EnvironmentFile=%h/.config/secrets/notebooklm-rest-api.env
ExecStart=%h/CascadeProjects/ada-voice/.venv/bin/uvicorn pwa_server:app --host 0.0.0.0 --port 8003
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
