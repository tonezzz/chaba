[Unit]
Description=Google Home LAN MCP server (rootless podman) on mn01
After=network-online.target tailscaled.service
Wants=network-online.target

[Container]
Image=localhost/google-home-mcp:latest
ContainerName=google-home-mcp
Network=host
Environment=BIND_HOST=100.106.196.22
Environment=PORT=8004
Environment=CAST_HOSTS=192.168.2.85
AutoUpdate=local

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
