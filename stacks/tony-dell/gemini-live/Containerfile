FROM docker.io/library/node:22-alpine

# mcp_rview/server.py runs under Python 3.
RUN apk add --no-cache python3

WORKDIR /app
COPY stacks/web/gemini-live/package*.json ./
RUN npm ci --omit=dev
COPY stacks/web/gemini-live/server.mjs ./
COPY scripts/mcp_rview /scripts/mcp_rview

EXPOSE 3008

ENV GEMINI_LIVE_PORT=3008
ENV GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
ENV RVIEW_API_URL=http://127.0.0.1:3007/state.php

CMD ["node", "server.mjs"]
