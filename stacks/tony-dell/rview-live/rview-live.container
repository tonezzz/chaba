[Unit]
Description=RView Live API (rootless podman)
Requires=rview-live-image-build.service rview-api.service
After=rview-live-image-build.service rview-api.service

[Container]
Image=localhost/rview-live:latest
ContainerName=rview-live
Network=host
Environment=GEMINI_LIVE_PORT=3008
Environment=GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
Environment=RVIEW_API_URL=http://127.0.0.1:3007/state
Secret=gemini-api-key,type=env,target=GEMINI_API_KEY
AutoUpdate=local
HealthCmd=curl -sf http://127.0.0.1:3008/health >/dev/null
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
