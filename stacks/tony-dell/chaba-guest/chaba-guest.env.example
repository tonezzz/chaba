# chaba-guest.service environment — copy to ~/.config/secrets/chaba-guest.env
# on tony-dell and fill in the secrets. Never commit the real file.

# Chaba mode: file-backed memory, no MDDB.
CHABA_MEMORY=1
CHABA_DIR=/home/tony/.local/share/chaba

# Upstream Home Assistant (loopback on the same host).
HOME_ASSISTANT_URL=http://127.0.0.1:8123
HOME_ASSISTANT_TOKEN=<long-lived admin token for tony-ha>

# Shared guest HA account for the auto-login bridge. The password is set once
# when the guest user is created (see README step "guest HA user").
CHABA_HA_ORIGIN=http://192.168.2.67:8125
CHABA_GUEST_USER=guest
CHABA_GUEST_PASSWORD=<random generated password>

# Gemini Live backend (same key family as ada-pi instances).
GEMINI_API_KEY=<key>

# Auth: guests redeem one-time entry links minted from the admin pair page.
ADA_API_KEY=<admin key for minting/promote/revoke>

# Optional: speaker-ID for voice enrollment (needs speechbrain deps).
ADA_SPEAKER_ID=true
