[Unit]
Description=LAN-only HA proxy for guests (Caddy, 192.168.2.67:8125 -> 127.0.0.1:8123, XFF)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Reverse proxy (not raw TCP): sets X-Forwarded-For so HA sees the real LAN
# client IP. Raw socat would make every guest appear as 127.0.0.1 — dangerous
# once loopback is in trusted_networks for the chaba login bridge.
ExecStart=/usr/bin/caddy run --config %h/.config/chaba/Caddyfile.guest --adapter caddyfile
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
