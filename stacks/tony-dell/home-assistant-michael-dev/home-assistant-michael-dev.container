[Unit]
Description=Michael Home Assistant dev instance (rootless podman)
After=network.target

[Container]
Image=docker.io/homeassistant/home-assistant:stable
ContainerName=home-assistant-michael-dev
Network=slirp4netns
PublishPort=8124:8123
Volume=/home/tony/.config/home-assistant-michael-dev:/config:Z
Volume=/etc/localtime:/etc/localtime:ro
AutoUpdate=registry
HealthCmd=/bin/bash -c 'curl -sf http://127.0.0.1:8123/ >/dev/null'
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=120s

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
