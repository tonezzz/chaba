[Unit]
Description=Michael HA MCP tunnel on tony-dell
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o IdentitiesOnly=yes -i /home/tony/.ssh/michael-ha -o GatewayPorts=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -N -L 0.0.0.0:19584:172.30.32.1:9584 root@michael-ha
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
