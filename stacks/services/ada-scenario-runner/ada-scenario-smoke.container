[Unit]
Description=Ada live-scenario runner — smoke tier (safe, no actuation)
After=network-online.target ada-dev.service

[Container]
Image=localhost/ada-scenario-runner:latest
ContainerName=ada-scenario-smoke
Network=host
Volume=%h/CascadeProjects/ada-voice:/app:ro
# Bench-off-paid-lanes (BEN-0573 / OPS-0509): smoke targets ada-dev
# (:8005, FREE Gemini key) — the hourly suite used to open ~39 real
# billed sessions/hour on ada-ha-tony (admin = ~78% of that lane's
# daily input tokens). Prod lanes stay untouched except the release-s4
# dev-twin gate a card explicitly requests.
Volume=%h/.config/secrets/ada-ha-dev-keys.json:/secrets/keys.json:ro
Volume=%h/.config/secrets/ada-ha-michael.env:/secrets/michael.env:ro
Volume=%h/.config/secrets/ada-ha-michael-keys.json:/secrets/michael-keys.json:ro
Environment=ADA_LIVE_URL=ws://127.0.0.1:8005/ws
Environment=MDDB_BASE_URL=http://100.102.134.91:11023/v1
Environment=ADA_KEYS_FILE=/secrets/keys.json
EnvironmentFile=%h/.config/secrets/ada-dev.env
Exec=--tier smoke

[Service]
Type=oneshot
RemainAfterExit=no
TimeoutStartSec=2700
WorkingDirectory=%h/CascadeProjects/ada-voice
Environment=MDDB_BASE_URL=http://100.102.134.91:11023/v1
# Spend guard (card scenario-spend-guard): probe once per run — unit
# active, free-lane key, no provider dunning in the last 70min — else
# skip the tier entirely and record skip-quota reports (zero sessions
# opened). Also runs the reconnect-churn counter every fire.
# Shell wrapper: pass (exit 0) when the chaba checkout hasn't landed the
# gate yet — a missing script must not silently disable the suite.
ExecCondition=/bin/sh -c 'G=%h/CascadeProjects/chaba/scripts/ada/scenario-provider-gate.py; [ -f "$G" ] || exit 0; exec /usr/bin/python3 "$G" --unit ada-dev --env-file %h/.config/secrets/ada-dev.env'
ExecStopPost=%h/CascadeProjects/ada-voice/.venv/bin/python scripts/ada/lab-results.py
# '-' prefix: an audit hiccup must not flip the smoke run to failed
ExecStopPost=-/usr/bin/python3 %h/CascadeProjects/chaba/scripts/ada/cms-audit.py --publish
# refresh today's spend-ledger line after each real run (best-effort;
# skipped file = no-op until the chaba checkout lands it)
ExecStopPost=-/bin/sh -c 'L=%h/CascadeProjects/chaba/scripts/ada/spend-ledger.py; [ -f "$L" ] && exec /usr/bin/python3 "$L" || true'

[Install]
WantedBy=default.target
