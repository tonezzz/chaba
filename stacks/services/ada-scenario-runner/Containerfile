FROM docker.io/python:3.12-slim
RUN pip install --no-cache-dir websockets pyyaml
# Repo is bind-mounted at /app (read-only): scenarios, driver, keys live there.
# Entrypoint shim applies the OPS-0581 exit-code contract (exit 0 on a
# completed run — the final "N scenarios:" marker proves completion).
COPY container-suite-run.sh /usr/local/bin/container-suite-run
RUN chmod 0755 /usr/local/bin/container-suite-run
ENTRYPOINT ["/usr/local/bin/container-suite-run"]
