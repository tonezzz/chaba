[Unit]
Description=Ada live-scenario runner — full tier (incl. actuation scenarios)
After=network-online.target

[Container]
Image=localhost/ada-scenario-runner:latest
ContainerName=ada-scenario-full
Network=host
Volume=/home/tony/CascadeProjects/ada-voice:/app:ro
Volume=/home/tony/.config/secrets/ada-ha-tony-keys.json:/secrets/keys.json:ro
Environment=ADA_LIVE_URL=ws://127.0.0.1:8002/ws
Environment=MDDB_BASE_URL=http://100.102.134.91:11023/v1
Environment=ADA_KEYS_FILE=/secrets/keys.json
EnvironmentFile=/home/tony/.config/secrets/ada-ha-tony.env
Exec=--tier full

[Service]
Type=oneshot
RemainAfterExit=no
# Bench-off-paid-lanes (BEN-0573): full tier is manual + prod-lane —
# card-requested only. Authorize ONE run with
#   echo <card-id> > ~/.local/share/ada-scenario-runner/prod-allow-full
# then systemctl --user start ada-scenario-full. The gate (1) verifies
# the sentinel (<7d old) and provider health; (2) consumes the sentinel
# so it cannot silently re-arm. Both ExecConditions run in order.
ExecCondition=/bin/sh -c 'G=%h/CascadeProjects/chaba/scripts/ada/scenario-provider-gate.py; [ -f "$G" ] || exit 1; exec /usr/bin/python3 "$G" --unit ada-ha-tony --env-file %h/.config/secrets/ada-ha-tony.env --tier full --paid-allow-file %h/.local/share/ada-scenario-runner/prod-allow-full'
ExecCondition=/bin/rm -f %h/.local/share/ada-scenario-runner/prod-allow-full
TimeoutStartSec=3600

[Install]
WantedBy=default.target
