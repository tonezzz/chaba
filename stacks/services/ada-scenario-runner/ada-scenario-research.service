[Unit]
Description=Ada live-scenario benchmark — research suite (weekly, dev lane)
After=network-online.target mddb.service ada-dev.service

[Service]
Type=oneshot
WorkingDirectory=%h/CascadeProjects/ada-voice
EnvironmentFile=%h/.config/secrets/ada-dev.env
Environment=MDDB_BASE_URL=http://100.102.134.91:11023/v1
# Bench-off-paid-lanes (BEN-0573): runs on ada-dev (:8005, FREE key).
# Prod persona lanes are card-requested only — see scenario-suite-run.sh
Environment=ADA_LIVE_URL=ws://127.0.0.1:8005/ws
Environment=ADA_KEYS_FILE=%h/.config/secrets/ada-ha-dev-keys.json
Environment=PYTHONUNBUFFERED=1
# Provider gate: ada-dev active + free-lane key + no quota dunning —
# skip the suite cleanly instead of storming a dead provider. Missing
# gate script must not disable the suite (checkout drift) -> exit 0.
ExecCondition=/bin/sh -c 'G=%h/CascadeProjects/chaba/scripts/ada/scenario-provider-gate.py; [ -f "$G" ] || exit 0; exec /usr/bin/python3 "$G" --unit ada-dev --env-file %h/.config/secrets/ada-dev.env --tier research'
# Wrapper queues behind the :8199 suite lock (<=30m wait + refused-bind
# retries) instead of dropping the run — see scenario-suite-run.sh.
ExecStart=%h/.local/share/ada-scenario-runner/scenario-suite-run.sh research
TimeoutStartSec=5400
