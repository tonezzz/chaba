# ~/.config/secrets/litellm.env on idc03 — generated by deploy.sh, never committed.
POSTGRES_USER=litellm
POSTGRES_DB=litellm
POSTGRES_PASSWORD=<generate: openssl rand -hex 24>
DATABASE_URL=postgresql://litellm:<same-as-postgres-password>@127.0.0.1:5432/litellm
LITELLM_MASTER_KEY=sk-<generate: openssl rand -hex 24>
LITELLM_SALT_KEY=sk-<generate: openssl rand -hex 24>   # must persist — virtual keys die without it
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=<generate: openssl rand -hex 12>

# ~/.config/secrets/litellm-keys.env — minted via scripts/litellm/mint-key.sh
LITELLM_URL=http://100.102.134.91:4000
LITELLM_KEY_ADA=sk-<virtual>
LITELLM_KEY_CHABA=sk-<virtual>
LITELLM_KEY_BENCH=sk-<virtual>
