FROM node:22-slim

# python3 is needed by mcp-health-client.py, which spawns the node mcp-health server
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    NODE_ENV=production

CMD ["node"]
