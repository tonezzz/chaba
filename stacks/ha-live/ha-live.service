[Unit]
Description=Home Assistant Live (Gemini Live bridge)
After=home-assistant.service
Requires=home-assistant.service

[Service]
ExecStartPre=-/usr/bin/podman exec home-assistant mkdir -p /config/ha-live
ExecStartPre=-/usr/bin/podman exec home-assistant pkill -f 'python3 /config/ha-live/bridge.py'
ExecStart=/usr/bin/podman exec -i home-assistant python3 /config/ha-live/bridge.py
ExecStop=-/usr/bin/podman exec home-assistant pkill -f 'python3 /config/ha-live/bridge.py'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
